>> forecasting_round = (x :: Num) -> Num => < x + 3 >
>> forecasting_wrap = (x :: Num) -> Num => < x + 4 >
>> forecasting_snap = (x :: Num) -> Num => < x + 5 >
>> forecasting_bias = (x :: Num) -> Num => < x + 6 >
>> forecasting_damp = (x :: Num) -> Num => < x + 7 >
>> forecasting_boost = (x :: Num) -> Num => < x + 8 >
>> forecasting_trim = (x :: Num) -> Num => < x + 9 >
