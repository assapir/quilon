>> batching_wrap = (x :: Num) -> Num => < x + 4 >
>> batching_snap = (x :: Num) -> Num => < x + 5 >
>> batching_bias = (x :: Num) -> Num => < x + 6 >
>> batching_damp = (x :: Num) -> Num => < x + 7 >
>> batching_boost = (x :: Num) -> Num => < x + 8 >
>> batching_trim = (x :: Num) -> Num => < x + 9 >
