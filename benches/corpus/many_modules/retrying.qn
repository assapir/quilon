>> retrying_offset = (x :: Num) -> Num => < x + 0 >
>> retrying_scale = (x :: Num) -> Num => < x + 1 >
>> retrying_clamp = (x :: Num) -> Num => < x + 2 >
>> retrying_round = (x :: Num) -> Num => < x + 3 >
>> retrying_wrap = (x :: Num) -> Num => < x + 4 >
>> retrying_snap = (x :: Num) -> Num => < x + 5 >
>> retrying_bias = (x :: Num) -> Num => < x + 6 >
>> retrying_damp = (x :: Num) -> Num => < x + 7 >
>> retrying_boost = (x :: Num) -> Num => < x + 8 >
>> retrying_trim = (x :: Num) -> Num => < x + 9 >
