>> matching_wrap = (x :: Num) -> Num => x + 4
>> matching_snap = (x :: Num) -> Num => x + 5
>> matching_bias = (x :: Num) -> Num => x + 6
>> matching_damp = (x :: Num) -> Num => x + 7
>> matching_boost = (x :: Num) -> Num => x + 8
>> matching_trim = (x :: Num) -> Num => x + 9
