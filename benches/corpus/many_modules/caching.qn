>> caching_offset = (x :: Num) -> Num => < x + 0 >
>> caching_scale = (x :: Num) -> Num => < x + 1 >
>> caching_clamp = (x :: Num) -> Num => < x + 2 >
>> caching_round = (x :: Num) -> Num => < x + 3 >
>> caching_wrap = (x :: Num) -> Num => < x + 4 >
>> caching_snap = (x :: Num) -> Num => < x + 5 >
>> caching_bias = (x :: Num) -> Num => < x + 6 >
>> caching_damp = (x :: Num) -> Num => < x + 7 >
>> caching_boost = (x :: Num) -> Num => < x + 8 >
>> caching_trim = (x :: Num) -> Num => < x + 9 >
