>> formatting_offset = (x :: Num) -> Num => x + 0
>> formatting_scale = (x :: Num) -> Num => x + 1
>> formatting_clamp = (x :: Num) -> Num => x + 2
>> formatting_round = (x :: Num) -> Num => x + 3
>> formatting_wrap = (x :: Num) -> Num => x + 4
>> formatting_snap = (x :: Num) -> Num => x + 5
>> formatting_bias = (x :: Num) -> Num => x + 6
>> formatting_damp = (x :: Num) -> Num => x + 7
>> formatting_boost = (x :: Num) -> Num => x + 8
>> formatting_trim = (x :: Num) -> Num => x + 9
