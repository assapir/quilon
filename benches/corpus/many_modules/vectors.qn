>> vectors_offset = (x :: Num) -> Num => < x + 0 >
>> vectors_scale = (x :: Num) -> Num => < x + 1 >
>> vectors_clamp = (x :: Num) -> Num => < x + 2 >
>> vectors_round = (x :: Num) -> Num => < x + 3 >
>> vectors_wrap = (x :: Num) -> Num => < x + 4 >
>> vectors_snap = (x :: Num) -> Num => < x + 5 >
>> vectors_bias = (x :: Num) -> Num => < x + 6 >
>> vectors_damp = (x :: Num) -> Num => < x + 7 >
>> vectors_boost = (x :: Num) -> Num => < x + 8 >
>> vectors_trim = (x :: Num) -> Num => < x + 9 >
