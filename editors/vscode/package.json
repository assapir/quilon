{
  "name": "quilon",
  "displayName": "Quilon",
  "description": "Syntax highlighting and editor tasks for the Quilon programming language (.qn).",
  "version": "0.9.3",
  "publisher": "assapir",
  "icon": "icon.png",
  "license": "GPL-2.0-only",
  "packageManager": "pnpm@11.20.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/assapir/quilon.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "activationEvents": [
    "onLanguage:quilon"
  ],
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "extensionDependencies": [
    "vadimcn.vscode-lldb"
  ],
  "keywords": [
    "quilon",
    "qn",
    "language"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "pnpm run compile && node --test \"out/**/*.test.js\"",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "fmt": "oxfmt --write src",
    "fmt:check": "oxfmt --check src",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.82.0",
    "@vscode/vsce": "^3.9.2",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2"
  },
  "contributes": {
    "languages": [
      {
        "id": "quilon",
        "aliases": [
          "Quilon",
          "quilon"
        ],
        "extensions": [
          ".qn"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/qn-light.png",
          "dark": "./icons/qn-dark.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "quilon",
        "scopeName": "source.quilon",
        "path": "./syntaxes/quilon.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "quilon.check",
        "title": "Quilon: Check Current File"
      },
      {
        "command": "quilon.run",
        "title": "Quilon: Run Current File"
      },
      {
        "command": "quilon.debug",
        "title": "Quilon: Debug Current File"
      },
      {
        "command": "quilon.runTests",
        "title": "Quilon: Run Tests in Current File"
      }
    ],
    "taskDefinitions": [
      {
        "type": "quilon"
      }
    ],
    "breakpoints": [
      {
        "language": "quilon"
      }
    ],
    "debuggers": [
      {
        "type": "quilon",
        "label": "Quilon",
        "languages": [
          "quilon"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the .qn file to build with debug info and launch. Defaults to the active file.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "description": "Arguments passed to the program (available via the entry point's args).",
                "items": {
                  "type": "string"
                },
                "default": []
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "quilon",
            "request": "launch",
            "name": "Quilon: Debug current file",
            "program": "${file}",
            "args": []
          }
        ],
        "configurationSnippets": [
          {
            "label": "Quilon: Debug current file",
            "description": "Build the active .qn with debug info and debug it under CodeLLDB.",
            "body": {
              "type": "quilon",
              "request": "launch",
              "name": "Quilon: Debug current file",
              "program": "^\"\\${file}\"",
              "args": []
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Quilon",
      "properties": {
        "quilon.command": {
          "type": "string",
          "default": "quilon",
          "description": "How to invoke the Quilon compiler. Use \"quilon\" if the binary is on your PATH, or e.g. \"cargo run --\" to run from a checkout of the compiler repo."
        }
      }
    }
  }
}
