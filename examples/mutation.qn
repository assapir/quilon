~ In-place record mutation. The binding operator decides mutability, for instances
~ and for methods alike:
~   `=`  -> immutable: no field writes, and a method that promises not to mutate.
~   `:=` -> mutable: in-place field writes, and a method that may mutate `it`.
~ Calling a `:=` method needs a `:=` receiver.
~ `<< core.test` verifies each mutation; on success the program exits 0.
<< core.test

Counter = {
  value :: Num,

  ~ A setter: declared with `:=`, so it may mutate in place.
  bump := (by :: Num) => it.value := it.value + by,

  peek = => it.value

  ~ Also `:=`: the write is inside a lambda, but it still lands on `it`.
  bumpEach := (steps :: []Num) => steps.each(s => it.value := it.value + s)
}

^ = () -> $ => <
  c := Counter { value = 30 }   ~ `:=` -> mutable instance
  c.bump(5)                      ~ setter mutates: value = 35
  assertEq(c.peek(), 35)
  c.value := c.value + 7         ~ direct field write: value = 42
  assertEq(c.peek(), 42)
  c.bumpEach([1, 2, 3])          ~ setter writing from inside a lambda: value = 48
  assertEq(c.peek(), 48)
>
