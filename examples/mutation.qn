~ In-place mutation. The binding operator decides mutability, for instances, arrays,
~ and methods alike:
~   `=`  -> immutable: no field/element writes, and a method that promises not to mutate.
~   `:=` -> mutable: in-place field/element writes, and a method that may mutate `it`.
~ Calling a `:=` method needs a `:=` receiver; writing `arr[i] := v` needs a `:=` array.
~ `<< core.test` verifies each mutation; on success the program exits 0.
<< core.test

Counter = {
  value :: Num,

  ~ A setter: declared with `:=`, so it may mutate in place.
  bump := (by :: Num) => < it.value := it.value + by >,

  peek = => < it.value >

  ~ Also `:=`: the write is inside a lambda, but it still lands on `it`.
  bumpEach := (steps :: []Num) => < steps.each(s => it.value := it.value + s) >
}

^ = () -> $ => <
  c := Counter { value = 30 }   ~ `:=` -> mutable instance
  c.bump(5)                      ~ setter mutates: value = 35
  assert(c.peek(), equals(35))
  c.value := c.value + 7         ~ direct field write: value = 42
  assert(c.peek(), equals(42))
  c.bumpEach([1, 2, 3])          ~ setter writing from inside a lambda: value = 48
  assert(c.peek(), equals(48))

  ~ An array element write is the array analog of a field write: in place, on a
  ~ `:=`-bound array.
  nums :: []Num := [10, 20, 30]
  nums[0] := 99
  assert(nums[0], equals(99))
  assert(nums.size, equals(3))
>
