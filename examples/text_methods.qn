~ Built-in `Text` methods, verified with `core.test` assertions: every assertion below
~ holds, so the program runs to completion and exits 0 (a failing assertion prints to
~ io.stderr and exits 5). Methods (grapheme-based where an index/length is user-visible):
~   split(sep)                        -> []Text  (empty sep -> graphemes; empties preserved)
~   join(separator)                   -> Text    ([]Text only; the reverse of split)
~   trim() / trimStart() / trimEnd()  -> Text    (strip both / leading / trailing whitespace)
~   replaceAll(from, to)              -> Text    (replace every occurrence)
~   replace(from, to, count)          -> Text    (exactly the first `count`; count > 0)
~   contains(sub)                     -> Bool
~   indexOf(sub)                      -> Ok(Num) grapheme index / NotOk   (no -1 sentinel)
~   indexOf(sub, from)                -> Ok(Num) grapheme index at or after `from` / NotOk
~   slice(start, end)                 -> Text    (grapheme indices, clamped; end exclusive)
~   at(index)                         -> Ok(Text) the grapheme there / NotOk out of bounds
~   graphemes()                       -> []Text  (one length-1 Text per grapheme cluster)
~   toUpper() / toLower()             -> Text    (Unicode-aware case mapping)
<< core.test

~ Counts every occurrence of `sub` in `t`, carrying its search position forward
~ through `indexOf(sub, from)` instead of re-scanning from the start each time.
countOccurrences = (t :: Text, sub :: Text, from :: Num, found :: Num) -> Num => <
  t.indexOf(sub, from) ?
    | Ok(i)    => countOccurrences(t, sub, i + 1, found + 1)
    | NotOk(_) => found
>

^ = () -> $ => <
  ~ split -> []Text; its pieces are genuine Text values.
  parts = "Hello, World".split(", ")
  assert(parts.size, equals(2))
  assert(parts[0], equals("Hello"))
  assert(parts[1], equals("World"))
  ~ consecutive separators keep empty pieces; empty haystack -> [""]; empty sep -> graphemes.
  assert("a,,b".split(",").size, equals(3))
  assert("".split(",").size, equals(1))
  assert("héllo".split("").size, equals(5))
  ~ split on a 4-byte emoji separator.
  assert("a🌍b🌍c".split("🌍").size, equals(3))

  ~ join is the reverse of split: rejoining split's own pieces with the same
  ~ separator reconstructs the original text; a different separator, or none.
  assert(parts.join(", "), equals("Hello, World"))
  assert(parts.join(" & "), equals("Hello & World"))
  assert(parts.join(""), equals("HelloWorld"))
  ~ join composes with map: render each element to Text first.
  assert([1, 2, 3].map(n => "`n`").join("-"), equals("1-2-3"))
  ~ an empty array joins to the empty text, whatever the separator.
  none :: []Text = []
  assert(none.join(", "), equals(""))

  ~ trim both sides; trimStart / trimEnd one side only (Unicode whitespace).
  assert("  hi  ".trim(), equals("hi"))
  assert("  hi  ".trimStart(), equals("hi  "))
  assert("  hi  ".trimEnd(), equals("  hi"))

  ~ replaceAll rewrites every match; replace(count) exactly the first `count`.
  assert("a-a-a".replaceAll("a", "xx"), equals("xx-xx-xx"))
  assert("a-a-a".replace("a", "xx", 1), equals("xx-a-a"))
  assert("a-a-a".replace("a", "xx", 2), equals("xx-xx-a"))
  ~ multibyte from/to: replace the 4-byte emoji with a 2-byte "é".
  assert("a🌍b🌍c".replaceAll("🌍", "é"), equals("aébéc"))

  ~ contains -> Bool.
  assert("Hello, World", contains("World"))
  assert("Hello", not(contains("zzz")))
  assert("a🌍b", contains("🌍"))

  ~ indexOf -> Ok(grapheme index) when found, NotOk when absent.
  assert("héllo".indexOf("llo"), isOk())
  assert("Hello".indexOf("z"), isNotOk())
  ~ the index counts graphemes: "b" sits past the 4-byte 🌍, at grapheme 2.
  idx = "a🌍b".indexOf("b") ?
    | Ok(i)    => i
    | NotOk(_) => 0 - 1
  assert(idx, equals(2))

  ~ indexOf(sub, from) finds the occurrence at or after `from`, letting a find loop
  ~ carry its position forward — countOccurrences never rescans from the start.
  sentence = "a quokka and a koala and a wombat share one paragraph"
  assert(countOccurrences(sentence, "and", 0, 0), equals(2))
  ~ searching past the last occurrence finds none; a negative `from` clamps to 0,
  ~ same as `slice`'s bounds.
  assert(sentence.indexOf("and", 100), isNotOk())
  first = sentence.indexOf("and", 0 - 5) ?
    | Ok(i)    => i
    | NotOk(_) => 0 - 1
  assert(first, equals(sentence.indexOf("and") ? | Ok(i) => i | NotOk(_) => 0 - 1))

  ~ slice over grapheme indices, end exclusive; out-of-range clamps; never splits a
  ~ multibyte codepoint mid-byte.
  assert("Hello".slice(1, 4), equals("ell"))
  assert("Hello".slice(-5, 100), equals("Hello"))
  assert("Hello".slice(3, 1), equals(""))
  assert("héllo".slice(1, 3), equals("él"))

  ~ at -> Ok(grapheme) / NotOk; a Text is a sequence of graphemes, and `at` reads one —
  ~ a multi-codepoint cluster (the 4-byte 🌍, a ZWJ emoji) comes back whole.
  assert("a🌍b".at(0), isOk())
  world = "a🌍b".at(1) ?
    | Ok(g)    => g
    | NotOk(_) => ""
  assert(world, equals("🌍"))
  assert("a🌍b".at(3), isNotOk())
  assert("abc".at(0 - 1), isNotOk())

  ~ graphemes -> []Text: the whole sequence at once, composing with the array methods.
  gs = "héllo".graphemes()
  assert(gs.size, equals(5))
  assert(gs[1], equals("é"))
  assert("".graphemes().size, equals(0))
  assert("👨‍👩‍👧".graphemes().size, equals(1))

  ~ case mapping, incl. non-ASCII and the 1->N "ß" -> "SS".
  assert("abc".toUpper(), equals("ABC"))
  assert("ABC".toLower(), equals("abc"))
  assert("é".toUpper(), equals("É"))
  assert("ß".toUpper(), equals("SS"))

  ~ []Text is a plain generic array: it composes with the array methods and `+`.
  assert("aa,b,ccc".split(",").map(w => w.size).reduce(0, (a, x) => a + x), equals(6))
  cat = "a,b".split(",") + "c,d".split(",")
  assert(cat.size, equals(4))
  assert(cat[3], equals("d"))
>
