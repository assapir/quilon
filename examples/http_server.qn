~ A chickpea stand over `http.@serve`: `hummus` answers a GET with what's on the counter, a
~ POST with what got stocked, and anything else with 405. `^` opens the stand, places one
~ order of each kind with `net.@tcpRequest` (the same round trip a real client would make),
~ asserts both replies, then closes the stand before returning.
<< core.http
<< core.net
<< core.test

hummus = (request :: http.Request) -> http.Response => <
  request.method ?
    | http.Get        => http.Response.ok("chickpeas: plenty")
    | http.Post(body) => http.Response.created("stocked " + body.content)
    | _               => http.Response.status(405)
>

^ = () -> Num => <
  stand = http.@serve("127.0.0.1:9048", request => hummus(request))

  net.@tcpRequest(
    "127.0.0.1:9048", "GET /counter HTTP/1.1\r\nHost: stand\r\nConnection: close\r\n\r\n") ?
    | Ok(reply)    => assert(reply, contains("chickpeas: plenty"))
    | NotOk(error) => test.failAt(error)

  net.@tcpRequest(
    "127.0.0.1:9048",
    "POST /counter HTTP/1.1\r\nHost: stand\r\nContent-Length: 5\r\nConnection: close\r\n\r\nbeans") ?
    | Ok(reply)    => assert(reply, contains("HTTP/1.1 201 Created"))
    | NotOk(error) => test.failAt(error)

  stand.kill(1)
  0
>
