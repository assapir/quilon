~ Ad-hoc overloading: multiple same-named typed definitions form an overload set,
~ resolved at each call site by the EXACT static argument types (no coercion).
~ FUNCTION overloading is top-level; OPERATOR overloading lives inside the type —
~ an operator is a member of the record or sum it operates on, with `it` the left operand.
~ `<< core.test` verifies every dispatch; on success the program exits 0.
<< core.test

~ --- A user function overload set: same name, different parameter types. ---
~ The call site picks the member whose parameter type matches exactly.
score = (n :: Num) -> Num => < n + 1 >    ~ Num overload
score = (s :: Text) -> Num => < s.size >  ~ Text overload (byte length)

~ --- Operator members on a record type. ---
~ `==` compares the two components; `it` is the left operand, the one parameter the right.
~ `` ` `` is a UNARY operator member (no parameter) — the type's Text rendering.
Color = {
  r :: Num, g :: Num,
  == = (other :: Color) -> Bool => < it.r == other.r && it.g == other.g >,
  `  = () -> Text => < "Color(`it.r`, `it.g`)" >
}

^ = () -> $ => <
  ~ Overload dispatch by argument type:
  assert(score(41), equals(42))      ~ Num overload
  assert(score("abcd"), equals(4))   ~ Text overload

  ~ User operator overload (`==` on Color), resolved from Color's members:
  assert(Color { r = 1, g = 2 }, equals(Color { r = 1, g = 2 }))
  assert(!(Color { r = 1, g = 2 } == Color { r = 9, g = 2 }), equals(true))

  ~ The `` ` `` member renders a Color (via interpolation, and via `print`):
  assert("`Color { r = 1, g = 2 }`", equals("Color(1, 2)"))

  ~ Built-in Text comparison overloads — equality and lexicographic ordering:
  assert("quilon", equals("quilon"))
  assert("abc" < "abd", equals(true))        ~ lexicographic: 'c' < 'd'
  assert("b" > "a", equals(true))            ~ bare `>` works on one line
>
