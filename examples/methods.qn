~ Named record types can declare methods. Inside a method, `it` is the instance.
~ `<< core.test` verifies the method result; on success the program exits 0.
<< core.test

Counter = {
  value :: Num,

  bump = (by :: Num) -> Num => < it.value + by >
}

~ Members may appear in any order — including a method WITH parameters as the very
~ first member, which the parser must tell apart from a record literal whose first
~ field holds a parenthesized value (e.g. `x = (1 + 2)`).
Greeter = {
  greet = (name :: Text) -> Text => < "Hello, " + name >,
  label :: Text
}

~ A top-level function may share a name with a method. The two are unrelated: a member
~ call asks the receiver's type, a plain call names this function.
bump = (by :: Num) -> Num => < by * 100 >
bump = (counter :: Counter, by :: Num) -> Num => < counter.value * by >

~ A method whose body never reads `it` — STATIC — may be called on the bare TYPE NAME
~ instead of on a value: the natural spelling for a constructor. A static method may be
~ overloaded: `at` dispatches on the type name by the argument count it is called with,
~ the same way a value-receiver overload dispatches on argument type.
Point = {
  x :: Num,
  y :: Num,
  origin = () -> Point => < Point { x = 0, y = 0 } >,
  at = (x :: Num) -> Point => < Point { x = x, y = x } >,
  at = (x :: Num, y :: Num) -> Point => < Point { x = x, y = y } >
}

^ = () -> $ => <
  c :: Counter = Counter { value = 30 }
  assert(c.bump(5), equals(35))     ~ Counter's method: it.value + 5
  assert(bump(5), equals(500))      ~ the top-level function: 5 * 100
  assert(bump(c, 5), equals(150))   ~ the top-level function too: 30 * 5

  g :: Greeter = Greeter { label = "front desk" }
  assert(g.greet("Alice"), equals("Hello, Alice"))
  assert(g.label, equals("front desk"))

  origin :: Point = Point.origin()
  assert(origin.x, equals(0))
  diagonal :: Point = Point.at(3)
  assert(diagonal.x + diagonal.y, equals(6))
  p :: Point = Point.at(3, 4)
  assert(p.x + p.y, equals(7))
>
