~ Block-scope join: a `< >` block joins every launch it made directly before it returns,
~ including one bound to a name it never reads again. `interrogate` launches two reads,
~ stores the second in `testimony`, and returns; `^` then reads a settled value.

<< core.io

testimony := ""

interrogate = () -> $ => <
  hearsay = io.@readStdin()       ~ launched, never read: the block joins it before returning
  testimony := io.@readStdin()    ~ stored deferred; forced where ^ reads it
>

^ = () -> Num => <
  interrogate()
  assert(testimony.length, equals(0))   ~ end-of-input: a settled, empty second line
  0
>
