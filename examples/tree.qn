~ A binary search tree: insert, an in-order walk into an array, depth, and a
~ rendered form, all as methods on the sum itself. `Tree` names itself inside
~ `Node`'s record payload (`{ Tree, Num, Tree }`) — a record is always
~ heap-allocated, so the self-reference needs no boxing of its own.
~ `<< core.test` verifies every result; on success the program exits 0.
<< core.test

Tree = Leaf / Node({ Tree, Num, Tree }) {
  insert = (n :: Num) -> Tree => <
    it ?
      | Leaf => Node({ Leaf, n, Leaf })
      | Node(node) => n == node.1
          ? it
          : n < node.1
            ? Node({ node.0.insert(n), node.1, node.2 })
            : Node({ node.0, node.1, node.2.insert(n) })
  >

  inOrder = (into :: []Num) -> []Num => <
    it ?
      | Leaf       => into
      | Node(node) => node.2.inOrder(node.0.inOrder(into) + node.1)
  >

  depth = () -> Num => <
    it ?
      | Leaf       => -1
      | Node(node) => 1 + (node.0.depth() > node.2.depth() ? node.0.depth() : node.2.depth())
  >

  ` = () -> Text => <
    it ?
      | Leaf       => "Leaf"
      | Node(node) => "Node(`node.0`, `node.1`, `node.2`)"
  >
}

^ = () -> $ => <
  tree = [5, 3, 8, 1, 4, 7, 9].reduce(Leaf, (t, n) => t.insert(n))
  assert(tree.inOrder([]).map(x => "`x`").join(","), equals("1,3,4,5,7,8,9"))
  assert(tree.depth(), equals(2))
  assert(Leaf.depth(), equals(-1))
  assert(Node({ Leaf, 1, Leaf }).depth(), equals(0))
  assert("`Node({ Leaf, 1, Leaf })`", equals("Node(Leaf, 1, Leaf)"))
>
