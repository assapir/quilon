~ A binary search tree: insert, an in-order walk into an array, and depth. `Tree`
~ names itself directly in `Node`'s payload — boxed into a GC cell at construction,
~ unboxed when a pattern binds it. `<< core.test` verifies every result; on success
~ the program exits 0.
<< core.test

Tree = Leaf / Node(Tree, Num, Tree)

insert = (t :: Tree, n :: Num) -> Tree => <
  t ?
    | Leaf => Node(Leaf, n, Leaf)
    | Node(left, value, right) => n == value
        ? t
        : n < value
          ? Node(insert(left, n), value, right)
          : Node(left, value, insert(right, n))
>

~ Appends every value to `into`, left subtree first, then the node, then right.
inOrder = (t :: Tree, into :: []Num) -> []Num => <
  t ?
    | Leaf => into
    | Node(left, value, right) => inOrder(right, inOrder(left, into) + value)
>

~ The number of edges from the root to its farthest leaf; a single node is depth 0.
depth = (t :: Tree) -> Num => <
  t ?
    | Leaf => -1
    | Node(left, _, right) => 1 + (depth(left) > depth(right) ? depth(left) : depth(right))
>

^ = () -> $ => <
  tree = [5, 3, 8, 1, 4, 7, 9].reduce(Leaf, (t, n) => insert(t, n))
  assert(inOrder(tree, []).map(x => "`x`").join(","), equals("1,3,4,5,7,8,9"))
  assert(depth(tree), equals(2))
  assert(depth(Leaf), equals(-1))
  assert(depth(Node(Leaf, 1, Leaf)), equals(0))
>
