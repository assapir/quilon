~ A binary search tree: insert, an in-order walk into an array, depth, and a
~ rendered form, all as methods on the sum itself. `Tree` names itself directly
~ in `Node`'s payload — boxed into a GC cell at construction, unboxed when a
~ pattern binds it. `<< core.test` verifies every result; on success the
~ program exits 0.
<< core.test

Tree = Leaf / Node(Tree, Num, Tree) {
  insert = (n :: Num) -> Tree => <
    it ?
      | Leaf => Node(Leaf, n, Leaf)
      | Node(left, value, right) => n == value
          ? it
          : n < value
            ? Node(left.insert(n), value, right)
            : Node(left, value, right.insert(n))
  >

  inOrder = (into :: []Num) -> []Num => <
    it ?
      | Leaf => into
      | Node(left, value, right) => right.inOrder(left.inOrder(into) + value)
  >

  depth = () -> Num => <
    it ?
      | Leaf => -1
      | Node(left, _, right) => 1 + (left.depth() > right.depth() ? left.depth() : right.depth())
  >

  ` = () -> Text => <
    it ?
      | Leaf                     => "Leaf"
      | Node(left, value, right) => "Node(`left`, `value`, `right`)"
  >
}

^ = () -> $ => <
  tree = [5, 3, 8, 1, 4, 7, 9].reduce(Leaf, (t, n) => t.insert(n))
  assert(tree.inOrder([]).map(x => "`x`").join(","), equals("1,3,4,5,7,8,9"))
  assert(tree.depth(), equals(2))
  assert(Leaf.depth(), equals(-1))
  assert(Node(Leaf, 1, Leaf).depth(), equals(0))
  assert("`Node(Leaf, 1, Leaf)`", equals("Node(Leaf, 1, Leaf)"))
>
