~ A match arm's binding shadows an outer binding of the same name only within that
~ arm.
~
~ Two raccoons rummage two separate bins, each either finding `loot` or leaving an
~ `excuse`. `tallyRaccoons` checks the second bin from inside the first's `Ok` arm,
~ reusing both payload names — and still reads the FIRST raccoon's own `loot`/`excuse`
~ correctly afterward.

tallyRaccoons = (frontBin :: Result, backBin :: Result) -> Num => <
  frontBin ?
    | Ok(loot)      => (backBin ?
        | Ok(loot)      => loot
        | NotOk(excuse) => excuse) + loot
    | NotOk(excuse) => (backBin ?
        | Ok(loot)      => loot
        | NotOk(excuse) => excuse) + excuse
>

^ = () -> $ => <
  ~ Front raccoon finds loot (10); back raccoon comes up empty (excuse 20).
  ~ The inner match yields 20; the outer `loot` (10) must still read as 10: 30.
  assert(tallyRaccoons(Ok(10), NotOk(20)), equals(30))

  ~ Both raccoons find loot: the inner arm's `loot` (5) and the outer's own `loot`
  ~ (10) are two distinct bindings, so their sum is 15, not double either one.
  assert(tallyRaccoons(Ok(10), Ok(5)), equals(15))

  ~ Front raccoon finds nothing (excuse 7); back raccoon also comes up empty
  ~ (excuse 3). The inner match yields 3; the outer `excuse` (7) must still read
  ~ as 7: 10.
  assert(tallyRaccoons(NotOk(7), NotOk(3)), equals(10))
>
