~ Closures: lexical capture, with the capture mode decided by the binding operator.
~   `=`  bindings are captured BY VALUE     — a frozen, read-only snapshot.
~   `:=` bindings are captured BY REFERENCE — a shared, mutable cell whose writes
~        escape the closure and persist across calls.
~ There is no capture list and no marker: the operator that bound the name is the
~ signal. (Closures are monomorphic in M3 — concrete-typed params and captures.)
~ A closure may also be RETURNED across the call boundary: the return type is written
~ as a function type — `(n :: Num) -> (Num) -> Num` returns a `(Num) -> Num` — and the
~ captures live on the GC heap, so they outlive the frame that made them. A lambda in
~ return position takes its parameter types from the declared return type, the same
~ way a lambda argument takes them from the receiving signature.
~ `<< core.test` verifies each behavior; on success the program exits 0.
<< core.test

~ The canonical returned closure: it captures the parameter `n` by value.
adder = (n :: Num) -> (Num) -> Num => < (x :: Num) => x + n >

~ The declared return `(Num) -> Num` types `x`, so the lambda may write no annotation.
scaler = (factor :: Num) -> (Num) -> Num => < (x) => x * factor >

~ A function value received as a parameter may be handed back out unchanged.
pick = (f :: (Num) -> Num) -> (Num) -> Num => < f >

~ A returned closure crosses further call boundaries like any other function value.
apply = (f :: (Num) -> Num, x :: Num) -> Num => < f(x) >

~ A `:=` capture is a shared heap cell, so the state survives the maker's frame:
~ each call through the returned closure keeps counting.
mkCounter = () -> () -> Num => <
  count := 0
  () -> Num => <
    count := count + 1
    count
  >
>

^ = () -> $ => <
  ~ `total` is `:=` -> captured by reference. `bump` mutates the shared cell, so
  ~ its writes accumulate across separate calls (they escape the closure).
  total := 0
  bump = (n :: Num) => <
    total := total + n
    total
  >

  assert(bump(10), equals(10))   ~ total -> 10
  assert(bump(20), equals(30))   ~ the same cell, written again

  ~ `base` is `=` -> captured by value. `addBase` sees a frozen copy; rebinding
  ~ `base` afterwards does NOT change what the closure already captured.
  base = 7
  addBase = (x :: Num) => < x + base >
  assert(addBase(5), equals(12))   ~ 5 + the =-captured 7

  ~ The :=-captured cell still holds its accumulated value.
  assert(total, equals(30))

  ~ A returned closure, called through a binding…
  add5 = adder(5)
  assert(add5(2), equals(7))

  ~ …or immediately: the callee is a function-valued expression, not a name.
  assert(adder(40)(2), equals(42))

  assert(scaler(3)(7), equals(21))
  assert(pick((n :: Num) => n * 2)(21), equals(42))

  ~ The returned closure passed straight on to another function.
  assert(apply(adder(10), 4), equals(14))

  ~ The counter's `:=` cell outlives mkCounter's frame — calls keep accumulating.
  tick = mkCounter()
  assert(tick(), equals(1))
  assert(tick(), equals(2))

  ~ Two counters are two cells: a second maker call starts from scratch.
  other = mkCounter()
  assert(other(), equals(1))
  assert(tick(), equals(3))
>
