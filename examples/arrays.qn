~ Arrays are `{ptr, size}`. `.size` is the element count; `[i]` indexes (0-based).
~ Indexing is CHECKED: an out-of-bounds, negative, or NaN index is a runtime
~ error (io.stderr + exit 1), never a raw read. `at(i)` is the non-aborting form.
~ `<< core.test` verifies the results; on success the program exits 0.
<< core.test

^ = () -> $ => <
  nums :: []Num = [1, 2, 3, 4, 5]
  first :: Num = nums[0]
  assert(first, equals(1))
  assert(nums[4], equals(5))
  assert(nums[4.6], equals(5))          ~ fractional index truncates toward zero
  assert(nums.size, equals(5))

  ~ `at` returns Ok in bounds, NotOk otherwise — including a NaN index.
  assert(nums.at(2), isOk())
  assert(nums.at(9), isNotOk())
  assert(nums.at(0 - 1), isNotOk())
  assert(nums.at(0 / 0), isNotOk())
>
