~ The pipe `|>` feeds the left value in as the FIRST argument of the right call:
~   x |> f        is  f(x)
~   x |> f(a)     is  f(x, a)
~   x |> f(a, b)  is  f(x, a, b)
~   a |> b |> c   is  c(b(a))
~ Because the injected value is just the first argument, the right side can be a
~ higher-order call — piping a value into a function that takes another function.
~ `<< core.test` verifies each piped result; on success the program exits 0.
<< core.test

double  = (x :: Num) -> Num => x * 2
addFive = (x :: Num) -> Num => x + 5

~ Multi-argument target: the piped value fills the first parameter, the written
~ arguments fill the rest.
addThree = (a :: Num, b :: Num, c :: Num) -> Num => a + b + c

~ Higher-order target: `f` is a function value the body calls on the piped `x`.
applyTo = (x :: Num, f :: (Num) -> Num) -> Num => f(x)

^ = () -> $ => <
  result :: Num = 10 |> double |> addFive   ~ addFive(double(10)) = 25
  assert(result, equals(25))

  ~ Multi-argument piping: 1 |> addThree(2, 3) is addThree(1, 2, 3).
  assert(1 |> addThree(2, 3), equals(6))

  ~ Piping into a higher-order call: 5 |> applyTo(f) is applyTo(5, f) is f(5).
  ~ This composes the pipe with a function-valued argument.
  assert(5 |> applyTo((n :: Num) => n * 10), equals(50))
>
