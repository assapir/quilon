~ A test suite: `describe` groups and `it` cases from `core.test`, each case checking
~ itself with the module's assertions.
~
~ Run: cargo run -- test examples/test_suite.qn    ~ exits 0 — every case passes
~
~ There is no `^` here. A top-level `describe(…)` is test code: `quilon test` synthesizes
~ the entry point that runs each block in order, and every other command leaves the blocks
~ out of the program entirely — so a suite alongside the code it tests costs a release build
~ nothing.
<< core.test

describe("Text", () => <
  it("trims both ends", () => assert("  padded  ".trim(), equals("padded")))
  it("finds a part", () => assert("haystack".contains("stack"), equals(true)))
  it("counts graphemes, not bytes", () => assert("héllo".length, equals(5)))

  ~ `describe` nests: the reporter indents by depth.
  describe("splitting", () => <
    it("splits on a separator", () => assert("a,b,c".split(",").size, equals(3)))
    it("keeps the whole text when the separator is absent", () =>
      assert("a,b,c".split(";").size, equals(1)))
  >
  )
>
)

describe("Num", () => <
  it("adds", () => assert(2 + 2, equals(4)))
  it("compares", () => assert(7 > 3, equals(true)))
>
)

describe("Result", () => <
  it("is Ok in bounds", () => assert([10, 20].at(0), isOk()))
  it("is NotOk out of bounds", () => assert([10, 20].at(9), isNotOk()))
>
)
