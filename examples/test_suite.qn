~ A test suite: `describe` groups and `it` cases from `core.test`, each case checking itself
~ with `expect(value, matcher)` — the recorded assertion. A failing one marks its case, skips
~ what is left of it, and lets the run carry on, so one report covers every case.
~
~ Run: cargo run -- test examples/test_suite.qn    ~ exits 0 — every case passes
~
~ There is no `^` here — a file of nothing but tests. A top-level `describe(…)` is test code:
~ `quilon test` synthesizes the entry point that runs each block in order, and every other
~ command leaves the blocks out of the program entirely.
<< core.test.report

describe("Text", () => <
  it("trims both ends", () => expect("  padded  ".trim(), equals("padded")))
  it("finds a part", () => expect("haystack", contains("stack")))
  it("counts graphemes, not bytes", () => expect("héllo".length, equals(5)))

  ~ `describe` nests: the reporter indents by depth.
  describe("splitting", () => <
    it("splits on a separator", () => expect("a,b,c".split(","), contains("b")))
    it("keeps the whole text when the separator is absent", () =>
      expect("a,b,c".split(";").size, equals(1)))
  >)
>)

describe("Num", () => <
  it("adds", () => expect(2 + 2, equals(4)))
  it("compares", () => expect(7 > 3, equals(true)))
  it("is not something else", () => expect(2 + 2, not(equals(5))))
>)

describe("Result", () => <
  it("is Ok in bounds", () => expect([10, 20].at(0), isOk()))
  it("is NotOk out of bounds", () => expect([10, 20].at(9), isNotOk()))
>)

~ The run's own state, as the reporter reads it — see docs/corelib/test.md.
describe("the run", () => <
  it("knows the group it is in", () => expect(nestingDepth(), equals(1)))
  it("has counted every case that closed", () => expect(casesFailed(), equals(0)))
>)
