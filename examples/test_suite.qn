~ A test suite: `describe` groups and `it` cases from `core.test`, each case checking itself
~ with `expect(value, matcher)` — the recorded assertion. A failing one marks its case, skips
~ what is left of it, and lets the run carry on, so one report covers every case.
~
~ Run: cargo run -- test examples/test_suite.qn    ~ exits 0 — every case passes
~
~ There is no `^` here — a file of nothing but tests. A top-level `test.describe(…)` is test code:
~ `quilon test` synthesizes the entry point that runs each block in order, and every other
~ command leaves the blocks out of the program entirely.
<< core.test

test.describe("Text", () => <
  test.it("trims both ends", () => expect("  padded  ".trim(), equals("padded")))
  test.it("finds a part", () => expect("haystack", contains("stack")))
  test.it("counts graphemes, not bytes", () => expect("héllo".length, equals(5)))

  ~ `describe` nests: the report indents by depth.
  test.describe("splitting", () => <
    test.it("splits on a separator", () => expect("a,b,c".split(","), contains("b")))
    test.it("keeps the whole text when the separator is absent", () =>
      expect("a,b,c".split(";").size, equals(1)))
  >)
>)

test.describe("Num", () => <
  test.it("adds", () => expect(2 + 2, equals(4)))
  test.it("compares", () => expect(7 > 3, equals(true)))
  test.it("is not something else", () => expect(2 + 2, not(equals(5))))
>)

test.describe("Result", () => <
  test.it("is Ok in bounds", () => expect([10, 20].at(0), isOk()))
  test.it("is NotOk out of bounds", () => expect([10, 20].at(9), isNotOk()))
>)

~ The run's own state, as the harness reads it — see docs/corelib/test/README.md.
test.describe("the run", () => <
  test.it("knows the group it is in", () => expect(test.nestingDepth(), equals(1)))
  test.it("has counted every case that closed", () => expect(test.casesFailed(), equals(0)))
>)
