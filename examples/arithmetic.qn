~ Arithmetic — one unified `Num` (f64). Every expectation below is asserted,
~ so the program exits 0.
<< core.test

^ = () -> $ => <
  ~ The four basics on integers.
  assert(5 + 7, equals(12))
  assert(50 - 8, equals(42))
  assert(6 * 7, equals(42))
  assert(84 / 2, equals(42))

  ~ ...and on fractionals, including mixed integer/fractional operands.
  assert(1.5 + 2.25, equals(3.75))
  assert(5.5 - 1.25, equals(4.25))
  assert(2.5 * 4, equals(10))
  assert(42 + 3.14, equals(45.14))

  ~ Division is f64 division — it produces fractions, and the fraction keeps
  ~ working in further arithmetic.
  assert(7 / 2, equals(3.5))
  assert(1 / 4, equals(0.25))
  assert(7 / 2 + 7 / 2, equals(7))

  ~ Unary minus, including double negation.
  x = 5
  assert(-x, equals(-5))
  assert(-(-x), equals(5))
  assert(-3 + 10, equals(7))

  ~ `%` is the f64 remainder: it works on fractional operands and the result
  ~ takes the DIVIDEND's sign (like C fmod / Rust %).
  assert(7 % 3, equals(1))
  assert(7.5 % 2, equals(1.5))
  assert(10 % 2.5, equals(0))
  assert((-7) % 3, equals(-1))   ~ sign follows the dividend...
  assert(7 % (-3), equals(1))    ~ ...not the divisor

  ~ Precedence: `*` / `/` / `%` bind tighter than `+` / `-`; parentheses override.
  assert(2 + 3 * 4, equals(14))
  assert((2 + 3) * 4, equals(20))
  assert(10 - 6 / 2, equals(7))
  assert(20 % 7 - 2 * 3, equals(0))
  $
>
