~ `Text` is a built-in type (no import needed, like Num or arrays).
~   "a" + "b"   concatenates (GC-allocated)
~   .size       byte length (UTF-8 bytes)
~   .length     grapheme-cluster count (user-perceived characters)
~ For "héllo" + " 🌍": .size = 11 bytes, .length = 7 graphemes.
~ `<< core.test` verifies both counts; on success the program exits 0.
<< core.test

^ = () -> $ => <
  s :: Text = "héllo" + " 🌍"
  assert(s.length, equals(7))   ~ 7 grapheme clusters
  assert(s.size, equals(11))    ~ 11 UTF-8 bytes

  ~ `Text` is LOGICAL order (docs/types/text.md#text-order): every index, length, search,
  ~ and concatenation addresses the order text was TYPED in — never the order a bidi-aware
  ~ display would draw a right-to-left script in. Hebrew and Arabic below prove it: `.at(0)`
  ~ is the first-TYPED letter, `.indexOf` counts from the start of what was typed, and `+`
  ~ never reorders what it joins.
  hebrew :: Text = "שלום"        ~ Hebrew "hello", 4 letters
  assert(hebrew.length, equals(4))
  first :: Text = hebrew.at(0) ? | Ok(g) => g | NotOk(_) => "?"
  assert(first, equals("ש"))     ~ the first-typed letter, not the last-drawn

  arabic :: Text = "مرحبا"        ~ Arabic "hello", 5 letters
  assert(arabic.length, equals(5))

  mixed :: Text = hebrew + " " + arabic   ~ `+` joins in typed order, Hebrew then Arabic
  assert(mixed, equals("שלום مرحبا"))
  assert(mixed.indexOf(arabic), isOk())   ~ found at its typed position

  sentence :: Text = "שלום, مرحبا, world"   ~ a mixed-direction sentence with punctuation
  parts :: []Text = sentence.split(", ")
  assert(parts.size, equals(3))
  assert(parts[0], equals(hebrew))
  assert(parts[1], equals(arabic))
  assert(parts[2], equals("world"))
>
