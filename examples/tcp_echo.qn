~ A raw TCP echo server: `net.@tcpServe` binds port `0` and starts the accept loop on its
~ own fiber, each connection gets `holler`'s handler on a fiber of its own, and `^` connects
~ to the server from inside the same process — passing the `Address` `Server.address()`
~ reports straight to `net.@tcpRequest` — to prove the round trip, asserts the echoed bytes,
~ then stops the server with `Server.kill` before returning.
<< core.net
<< core.test

holler = (connection :: net.Connection) -> $ => <
  ~ "" means either the peer closed or 2 seconds passed with nothing sent.
  shout = connection.@read(2)
  connection.@write(shout)
  $
>

^ = () -> $ => <
  canyon = net.@tcpServe("127.0.0.1:0", connection => holler(connection))
  net.@tcpRequest(canyon.address(), "hellooo") ?
    | Ok(echo) => assert(echo, equals("hellooo"))
    | NotOk(error) => test.failAt(error)
  canyon.kill(1)
>
