~ A singly linked list: cons, length, reverse, map, and a rendered form, all as
~ methods on the sum itself. `List` names itself inside `Cons`'s record payload
~ (`{ Num, List }`) — a record is always heap-allocated, so the self-reference
~ needs no boxing of its own. `<< core.test` verifies every result; on success
~ the program exits 0.
<< core.test

List = Empty / Cons({ Num, List }) {
  length = () -> Num => <
    it ?
      | Empty   => 0
      | Cons(c) => 1 + c.1.length()
  >

  reverseOnto = (acc :: List) -> List => <
    it ?
      | Empty   => acc
      | Cons(c) => c.1.reverseOnto(Cons({ c.0, acc }))
  >

  reverse = () -> List => < it.reverseOnto(Empty) >

  map = (f :: (Num) -> Num) -> List => <
    it ?
      | Empty   => Empty
      | Cons(c) => Cons({ f(c.0), c.1.map(f) })
  >

  ` = () -> Text => <
    it ?
      | Empty   => ""
      | Cons(c) => (c.1 ?
          | Empty   => "`c.0`"
          | Cons(_) => "`c.0`,`c.1`")
  >
}

^ = () -> $ => <
  list = Cons({ 1, Cons({ 2, Cons({ 3, Empty }) }) })
  assert(list.length(), equals(3))
  assert("`list.reverse()`", equals("3,2,1"))
  assert("`list.map(x => x * 10)`", equals("10,20,30"))
  assert(Empty.length(), equals(0))
>
