~ Tests beside the code they test: the `>>` exports, the `^` that uses them, and the
~ `describe` blocks checking them all share one file. Only `quilon test` compiles those
~ blocks — every other command erases them, so the line one case prints below reaches no
~ build, and `quilon test` in turn ignores the `^` and runs the blocks instead.
~
~ Run: cargo run -- run  examples/tests_alongside_code.qn    ~ prints the program's line only
~ Run: cargo run -- test examples/tests_alongside_code.qn    ~ runs the cases instead
<< core.io
<< core.test

>> slugify = (title :: Text) -> Text => title.trim().toLower().replaceAll(" ", "-")

>> wordCount = (line :: Text) -> Num => line.trim().split(" ").size

describe("slugify", () => <
  it("lowercases and hyphenates", () => assertEq(slugify("  Hello World  "), "hello-world"))
  it("leaves one lowercase word alone", () => assertEq(slugify("quilon"), "quilon"))
>
)

describe("wordCount", () => <
  it("counts the words of a line", () => assertEq(wordCount(" one two three "), 3))
>
)

describe("the erased block", () => <
  it("runs under quilon test and nowhere else", () => <
    print("ERASED-TEST-BLOCK-RAN")
    assertEq(slugify("Both Halves"), "both-halves")
  >
  )
>
)

^ = () -> $ => <
  print("PROGRAM-RAN-WITHOUT-ITS-TEST-BLOCKS")
  assertEq(slugify("  Hello World  "), "hello-world")
  assertEq(wordCount("one two three"), 3)
>
