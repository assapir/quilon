~ Tests beside the code they test: the `>>` exports, the `^` that uses them, and the
~ `describe` blocks checking them all share one file. Only `quilon test` compiles those
~ blocks — every other command erases them, so the line one case prints below reaches no
~ build, and `quilon test` in turn ignores the `^` and runs the blocks instead.
~
~ The harness needs no marker of its own: it follows the blocks that name it.
~
~ Run: cargo run -- run  examples/tests_alongside_code.qn    ~ prints the program's line only
~ Run: cargo run -- test examples/tests_alongside_code.qn    ~ runs the cases instead
<< core.io
<< core.test

>> slugify = (title :: Text) -> Text => < title.trim().toLower().replaceAll(" ", "-") >

>> wordCount = (line :: Text) -> Num => < line.trim().split(" ").size >

test.describe("slugify", () => <
  test.it("lowercases and hyphenates", () =>
    expect(slugify("  Hello World  "), equals("hello-world")))
  test.it("leaves one lowercase word alone", () => expect(slugify("quilon"), equals("quilon")))
>)

test.describe("wordCount", () => <
  test.it("counts the words of a line", () => expect(wordCount(" one two three "), equals(3)))
>)

test.describe("the erased block", () => <
  test.it("runs under quilon test and nowhere else", () => <
    io.print("ERASED-TEST-BLOCK-RAN")
    expect(slugify("Both Halves"), equals("both-halves"))
  >)
>)

^ = () -> $ => <
  io.print("PROGRAM-RAN-WITHOUT-ITS-TEST-BLOCKS")
  assert(slugify("  Hello World  "), equals("hello-world"))
  assert(wordCount("one two three"), equals(3))
>
