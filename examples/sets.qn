~ Built-in Set collection type, pipe-fenced: `[|T|]`.
~   Set: has / add / remove / items / size / each ; `+` union, `-` difference, `+-`/`-+` intersect.
~ Elements are Num/Text/Bool, or a user type that defines both a `%` hash hook (unary,
~   `it` the value, returning a Num) and an `==` equality — see the `Point` set below.
~ Sets are IMMUTABLE — every mutator returns a NEW set. Iteration order is UNSPECIFIED
~   (reproducible run-to-run via a fixed-seed hasher, but never rely on it).
~ `<< core.test` verifies every result; on success the program exits 0.
<< core.test

Point = {
  x :: Num, y :: Num,
  == = (other :: Point) -> Bool => it.x == other.x && it.y == other.y,
  % = () -> Num => it.x * 31 + it.y
}

^ = () -> $ => <
  primes :: [|Num|] = [|2, 3, 5, 7|]
  evens :: [|Num|] = [|2, 4, 6, 8|]

  ~ Duplicates collapse; membership and size are built in.
  dups :: [|Num|] = [|1, 1, 2, 2, 3|]
  assert(dups.size, equals(3))
  assert(primes.has(7), equals(true))
  assert(!primes.has(4), equals(true))

  ~ add is persistent, like map.set.
  more :: [|Num|] = primes.add(11)
  assert(primes.size, equals(4))
  assert(more.size, equals(5))

  ~ remove is persistent, like add: a NEW set without the element.
  fewer :: [|Num|] = primes.remove(2)
  assert(primes.size, equals(4))
  assert(fewer.size, equals(3))
  assert(!fewer.has(2), equals(true))
  ~ removing an absent element is a no-op (still a fresh, equal-size set).
  assert(primes.remove(42).size, equals(4))

  ~ items is a plain array of the elements.
  assert(primes.items().size, equals(4))

  ~ Set algebra: `+` union, `-` difference, `+-`/`-+` (symmetric) intersection.
  assert((primes + evens).size, equals(7))   ~ {2,3,5,7,4,6,8}
  assert((primes - evens).size, equals(3))   ~ {3,5,7}
  assert((primes +- evens).size, equals(1))  ~ {2}
  assert((primes -+ evens).size, equals(1))  ~ same operator, other spelling

  ~ each over a set, chaining on the returned receiver.
  count := 0
  primes.each(p => <
    count := count + 1
  >)
  assert(count, equals(4))

  ~ A Set of a user record type deduplicates by `%`/`==`.
  seen :: [|Point|] = [|Point { x = 1, y = 1 }, Point { x = 2, y = 2 }, Point { x = 1, y = 1 }|]
  assert(seen.size, equals(2))
  assert(seen.has(Point { x = 2, y = 2 }), equals(true))
>
