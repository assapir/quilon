~ Built-in Map collection type, pipe-fenced: `[|K => V|]` (`=>` reads "maps to").
~   Map: get / has / set / remove / keys / values / size / each.
~ Values are read only through `.get`, which returns `Ok(value)` when the key is present
~   and `NotOk` when it is absent — there is no bracket indexing on a map.
~ Keys are Num/Text/Bool, or a user type that defines both a `%` hash hook (unary,
~   `it` the value, returning a Num) and an `==` equality — see the `Point` map below.
~ `set`/`remove` are setters: they mutate a `:=`-bound map in place and return `it`, so
~   calls chain — a `:=` receiver is required. Iteration order is UNSPECIFIED
~   (reproducible run-to-run via a fixed-seed hasher, but never rely on it).
~ `<< core.test` verifies every result; on success the program exits 0.
<< core.test

Point = {
  x :: Num, y :: Num,
  == = (other :: Point) -> Bool => < it.x == other.x && it.y == other.y >,
  % = () -> Num => < it.x * 31 + it.y >
}

^ = () -> $ => <
  ages :: [|Text => Num|] := [|"ada" => 36, "alan" => 41, "grace" => 45|]

  assert(ages.size, equals(3))
  assert(ages.has("grace"), equals(true))
  assert(!ages.has("nobody"), equals(true))

  ~ Safe lookup returns a Result: Ok(value) present, NotOk absent.
  assert(ages.get("alan"), isOk())
  assert(ages.get("nobody"), isNotOk())
  found :: Num = ages.get("alan") ?
    | Ok(v)    => v
    | NotOk(_) => 0
  assert(found, equals(41))

  ~ `set` mutates `ages` in place and returns it, so the entry count read off the
  ~   return is the receiver's own.
  assert(ages.set("ada", 37).size, equals(3))
  updatedAge :: Num = ages.get("ada") ?
    | Ok(v)    => v
    | NotOk(_) => 0
  assert(updatedAge, equals(37))

  ~ `set`'s return value is the receiver, so calls chain: read `.size` right off it.
  assert(ages.set("carol", 50).size, equals(4))
  assert(ages.size, equals(4))

  ~ `remove` mutates in place too, and chains the same way.
  assert(ages.remove("carol").size, equals(3))
  assert(ages.get("carol"), isNotOk())
  ~ removing an absent key is a no-op (still the same, unchanged-size map).
  assert(ages.remove("nobody").size, equals(3))

  ~ keys / values are plain arrays (order unspecified), so array methods compose.
  total :: Num = ages.values().reduce(0, (acc, x) => acc + x)
  assert(total, equals(123))
  assert(ages.keys().size, equals(3))

  ~ each visits every entry for effect and returns the receiver (so it chains).
  sum := 0
  ages.each((name, age) => <
    sum := sum + age
  >)
  assert(sum, equals(123))

  ~ A Map keyed by a user record type hashes and compares keys through `%`/`==`.
  grid :: [|Point => Text|] := [|
    Point { x = 0, y = 0 } => "origin",
    Point { x = 1, y = 2 } => "here"
  |]
  assert(grid.has(Point { x = 0, y = 0 }), equals(true))
  assert(!grid.has(Point { x = 9, y = 9 }), equals(true))
  assert(grid.size, equals(2))

  ~ `.get` looks up by value equality, returning a Result.
  label :: Text = grid.get(Point { x = 1, y = 2 }) ? | Ok(t) => t | NotOk(_) => "missing"
  assert(label, equals("here"))

  ~ `set` mutates `grid` in place, so the receiver itself grows.
  grid.set(Point { x = 3, y = 4 }, "new")
  assert(grid.size, equals(3))
>
