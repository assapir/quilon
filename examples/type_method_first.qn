~ A named type's members may appear in any order — including a method WITH
~ parameters as the very first member. The parser must tell that shape apart from a
~ record literal whose first field holds a parenthesized value (e.g. `x = (1 + 2)`).
~ `<< core.test` verifies the method and field reads; on success the program exits 0.
<< core.test

Greeter = {
  greet = (name :: Text) -> Text => "Hello, " + name,
  label :: Text
}

^ = () -> $ => <
  g :: Greeter = Greeter { label = "front desk" }
  assert(g.greet("Alice"), equals("Hello, Alice"))
  assert(g.label, equals("front desk"))
>
