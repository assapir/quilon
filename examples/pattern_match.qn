~ Pattern matching with `?` and `|` arms; `_` is the wildcard.
~ Every match is TOTAL: a sum-typed scrutinee lists every variant, and any other
~ scrutinee needs a catch-all arm — `_`, or a binding like `| rest =>`. A match on
~ a `Num` that lists only some numbers is a compile error.
~ A constructor pattern's argument must be IRREFUTABLE — a binding (`Ok(x)`) or
~ `_` (`Ok(_)`). A literal there (`Ok(1)`) is a compile error: dispatch tests the
~ constructor tag only, so it would silently match ANY payload. Bind the payload
~ and compare it in the arm body instead, as `pick` does below.
~ A `Text` scrutinee may also be matched against literal text arms, alongside its catch-all.
~ A nested match's arm may bind a name an outer arm already bound; that inner binding
~ shadows the outer one only within its own arm.
<< core.test

~ A `Text` scrutinee matched against literal text arms, with a catch-all for anything
~ else — the same shape a `Num` match uses, now over words instead of numbers.
cast = (incantation :: Text) -> Text => <
  incantation ?
    | "abracadabra" => "a rabbit appears"
    | "shazam"      => "lightning cracks"
    | "open sesame" => "a door swings wide"
    | mumbled       => "nothing happens (you mumbled `mumbled`)"
>

~ A pattern is a plain literal; to compare against a computed text, bind the value and
~ compare it in the arm.
passphrase = "open " + "sesame"

unlock = (attempt :: Text) -> Text => <
  attempt ?
    | "abracadabra" => "wrong spell"
    | spoken        => spoken == passphrase ? "the door opens" : "the door stays shut"
>

~ Two raccoons check two bins; the second bin's arm reuses the first's own bound names
~ (`loot`/`excuse`), and the first's own binding still reads correctly once it is done.
tallyRaccoons = (frontBin :: Result, backBin :: Result) -> Num => <
  frontBin ?
    | Ok(loot)      => (backBin ?
        | Ok(loot)      => loot
        | NotOk(excuse) => excuse) + loot
    | NotOk(excuse) => (backBin ?
        | Ok(loot)      => loot
        | NotOk(excuse) => excuse) + excuse
>

^ = () -> $ => <
  ~ Binding and wildcard payload patterns.
  r = Ok(2)
  bound = r ?
    | Ok(x)     => x + 1
    | NotOk(_)  => 0
  assert(bound, equals(3))

  ~ The compare-in-the-body idiom replacing the illegal `| Ok(1) =>` form.
  pick = (v :: Num) -> Num => <
    q = Ok(v)
    q ?
      | Ok(n)    => n == 1 ? 10 : 20
      | NotOk(_) => 30
  >
  assert(pick(1), equals(10))
  assert(pick(2), equals(20))

  ~ Matching on a scalar value, with a wildcard fallthrough arm.
  value = 5
  picked = value ?
    | 0 => 10
    | 5 => 50      ~ matches here
    | _ => 99
  assert(picked, equals(50))

  ~ A binding arm is the other way to cover the rest: it matches anything and names
  ~ the value it matched.
  other = 7
  doubled = other ?
    | 0    => 0
    | rest => rest * 2
  assert(doubled, equals(14))

  assert(cast("shazam"), equals("lightning cracks"))
  assert(cast("abracadabra"), equals("a rabbit appears"))
  assert(cast("open sesame"), equals("a door swings wide"))
  assert(cast("fus ro dah"), equals("nothing happens (you mumbled fus ro dah)"))

  assert(unlock("open sesame"), equals("the door opens"))
  assert(unlock("please"), equals("the door stays shut"))

  assert(tallyRaccoons(Ok(10), NotOk(20)), equals(30))
  assert(tallyRaccoons(Ok(10), Ok(5)), equals(15))
  assert(tallyRaccoons(NotOk(7), NotOk(3)), equals(10))
>
