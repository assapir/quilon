~ User-defined sum types use `/` as the variant separator. Variants may be
~ nullary (`Red`) or carry built-in-typed payloads (`Rect({ Num, Num })`, `Ok($)`).
~ A variant carries at most one payload; several values travel together as one
~ record. Pattern-match with `?`/`|` to dispatch on the variant and bind its
~ payload; the match must be exhaustive — unless the checker has NARROWED an
~ `=` binding's variant (construction, a provable `assert`, or being inside a
~ match arm), in which case a match over it needs arms only for the variants
~ it can still be. `Result` (`Ok`/`NotOk`) is just a predefined sum type.
~ `<< core.test` verifies every result; on success the program exits 0.
<< core.test

~ A nullary enum.
Color = Red / Green / Blue

~ Map each color to a number.
rank = (c :: Color) -> Num => <
  c ?
    | Red   => 0
    | Green => 1
    | Blue  => 2
>

~ A sum type with payload variants. Rect's one payload is a positional record,
~ read back by position (`.0`, `.1`).
Shape = Circle(Num) / Rect({ Num, Num })

area = (s :: Shape) -> Num => <
  s ?
    | Circle(r) => 3 * r * r          ~ ~pi*r^2 (pi ~= 3 here, integer-only)
    | Rect(p)   => p.0 * p.1
>

~ A named record payload binds its fields by name instead of position.
Ticket = Standard(Num) / Discounted({ price :: Num, percentOff :: Num })

payable = (t :: Ticket) -> Num => <
  t ?
    | Standard(price) => price
    | Discounted(d)   => d.price - d.price * d.percentOff / 100
>

~ `Ok($)` is the canonical "succeeded, no meaningful value" Result; `NotOk(code)`
~ carries a failure code. Matching `Ok(_)` ignores the unit payload.
check = (n :: Num) -> Result => < n <= 100 ? Ok($) : NotOk(n) >

status = (n :: Num) -> Num => <
  check(n) ?
    | Ok(_)    => 0
    | NotOk(c) => c
>

~ --- Narrowing ------------------------------------------------------------
~ A package tracker: once the checker proves a binding's variant, a match
~ over it needs arms only for the variants left.
Parcel = Delivered(Num) / Lost(Text) / Delayed(Num)

~ Construction narrows `p` on the spot — the match below needs only the one
~ arm `p` can still be.
quickTrack = () -> Num => <
  p = Delivered(3)
  p ? | Delivered(days) => days
>

~ `assert`/`is(Variant)` narrows an `=` binding or a parameter the same way
~ construction does. This rules out `Lost` for the parameter `p`, so the match
~ needs only the two variants still possible — and `reportDays`, a lambda
~ written AFTER the `assert`, sees the proof too (one written before it would
~ not).
retrack = (p :: Parcel) -> Num => <
  assert(p, not(is(Lost)))
  reportDays = () => < p ? | Delivered(days) => days | Delayed(days) => days >
  reportDays()
>

~ Inside `| Delivered(days) => …`, `p` itself is known `Delivered` — proven
~ again here by re-matching it, now with only the one reachable arm.
confirmDelivered = (p :: Parcel) -> Num => <
  p ?
    | Delivered(_)  => (p ? | Delivered(same) => same)
    | Lost(reason)  => 0 - reason.size
    | Delayed(days) => 0 - days
>

~ --- `.payload` ---------------------------------------------------------------
~ Once the variant is known, `.payload` reads its payload with no match.
~ A multi-value payload is the variant's record.
Pastry = Croissant(Num) / Eclair({ Num, Num }) / Crumbs

bakedCount = (p :: Pastry) -> Num => <
  assert(p, is(Croissant))
  p.payload
>

~ A method named `payload` coexists with the accessor: a bare `.payload` reaches
~ the accessor, a call `.payload()` reaches the method.
Envelope = Sealed(Text) / Open(Text) {
  payload = () -> Text => < "hidden" >
}

peek = () -> Num => <
  e = Sealed("hi")
  e.payload.size * 100 + e.payload().size
>

^ = () -> $ => <
  assert(bakedCount(Croissant(12)), equals(12))
  assert(Eclair({ 6, 7 }).payload.1, equals(7))
  assert(peek(), equals(206))
  assert(area(Rect({ 6, 7 })), equals(42))   ~ 6 * 7
  assert(rank(Green), equals(1))
  assert(payable(Standard(80)), equals(80))
  assert(payable(Discounted({ price = 80, percentOff = 25 })), equals(60))
  assert(status(50), equals(0))          ~ 50 <= 100 -> Ok($) -> 0
  assert(status(200), equals(200))       ~ 200 > 100 -> NotOk(200) -> 200
  assert(quickTrack(), equals(3))
  assert(retrack(Delivered(5)), equals(5))
  assert(retrack(Delayed(2)), equals(2))
  assert(confirmDelivered(Delivered(7)), equals(7))
  assert(confirmDelivered(Lost("rain")), equals(0 - 4))
  assert(confirmDelivered(Delayed(2)), equals(0 - 2))
>
