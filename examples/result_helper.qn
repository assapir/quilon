~ A `Result` matched where it is produced, not forwarded into a helper's own bare
~ `:: Result` parameter for the helper to match: such a parameter carries no payload
~ type of its own, so a match that binds it there is rejected (QN351) rather than
~ guessed at. `judge` returns a `Result`; `^` matches that call directly and hands
~ `announce` the ALREADY-EXTRACTED, concrete `Text` — never the raw `Result` itself.
~ Run: cargo run -- run examples/result_helper.qn   (exits 0; assertions abort)

judge = (act :: Text) -> Result => <
  act == "" ? NotOk("nobody to judge") : Ok(act + " wins!")
>

announce = (verdict :: Text) -> Text => < "Ladies and gentlemen: " + verdict >

^ = () -> $ => <
  message = judge("a flamingo on a unicycle") ?
    | Ok(verdict) => announce(verdict)
    | NotOk(reason) => reason

  assert(message, equals("Ladies and gentlemen: a flamingo on a unicycle wins!"))

  silence = judge("") ?
    | Ok(verdict) => announce(verdict)
    | NotOk(reason) => reason
  assert(silence, equals("nobody to judge"))
>
