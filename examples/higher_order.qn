~ Higher-order functions: a function whose parameter is itself a function. A function
~ type is written with the arrow — `(Num) -> Num`, `(Num) -> Bool`, `() -> $` — and the
~ value passed in is a closure (here a lambda literal). A lambda takes its parameter
~ types from the signature that receives it, so the lambdas below write none of their own.
~ `<< core.test` verifies each result; on success the program exits 0.
<< core.test

~ Value-first so `x |> apply(f)` reads naturally: the piped subject is the first arg.
apply = (x :: Num, f :: (Num) -> Num) -> Num => f(x)

~ Calls `f` on its own result: f(f(x)).
twice = (f :: (Num) -> Num, x :: Num) -> Num => f(f(x))

~ A predicate parameter `(Num) -> Bool`: keep `x` when it holds, else 0.
keepIf = (p :: (Num) -> Bool, x :: Num) -> Num => p(x) ? x : 0

~ A `Text` function parameter: the lambda's `s` is a Text because `f` says it is.
around = (t :: Text, f :: (Text) -> Text) -> Text => f(t)

~ A `() -> $` parameter, called purely for effect: `run` invokes `action` twice.
run = (action :: () -> $) -> $ => <
  action()
  action()
>

^ = () -> $ => <
  ~ `apply`'s `(Num) -> Num` parameter is what types `n`.
  assert(apply(10, (n) => n + 1), equals(11))
  assert(10 |> apply((n) => n + 1), equals(11))
  assert(twice((n) => n * 3, 2), equals(18))

  ~ Writing the annotation stays legal, and wins where written.
  assert(apply(10, (n :: Num) => n + 1), equals(11))

  assert(keepIf((n) => n > 5, 9), equals(9))
  assert(keepIf((n) => n > 5, 3), equals(0))
  assert(around("hi", (s) => s + "!"), equals("hi!"))

  ~ A binding that declares its own function type states its parameter types too.
  scale :: (Num) -> Num = (n) => n * 4
  assert(scale(5), equals(20))

  ~ A named closure captures `total` by reference, so its writes escape and accumulate
  ~ across the two calls `run` makes. Passing it by name hands `run` the closure value.
  total := 0
  tick = () -> $ => <
    total := total + 5
    $
  >
  run(tick)
  assert(total, equals(10))
>
