~ `@name := …` declares an atomic binding. `@` marks the declaration only; every read and
~ reassignment after it is bare, the same rule a plain `:=` binding already follows.

@yakShaves := 0     ~ a top-level atomic global — one cell every call below shares

groom = (chore :: Text) -> Text => <
  yakShaves := yakShaves + 1    ~ bare after its declaration, like any `:=` reassignment
  chore
>

^ = () -> Num => <
  groom("brush the yak")
  groom("trim the yak")
  groom("photograph the yak")
  assert(yakShaves, equals(3))

  ~ The same syntax declares a local, wherever a `:=` declaration is allowed today.
  @sideQuests := 0
  sideQuests := sideQuests + 1
  assert(sideQuests, equals(1))

  0
>
