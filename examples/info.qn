~ core.info — facts about the build this program came from (see docs/corelib/info.md).
~ Every member is a compile-time constant, so the calls below appear in the emitted IR as
~ values, not calls. Self-asserting via core.test; exit 0 = pass.

<< core.io
<< core.test
<< core.info

^ = () -> Num => <
  print("`platform()`-`os()` `bits()`-bit `endianness()`-endian, quilon `quilonVersion()`")

  assert(quilonVersion().size > 0, equals(true))
  assert(platform().size > 0, equals(true))

  ~ The OS is spelled the way people say it: a `darwin` here would mean the triple leaked
  ~ through instead of being translated.
  assert(os() == "darwin", equals(false))

  ~ Every target Quilon builds for is one of these two.
  assert(bits() == 64 || bits() == 32, equals(true))
  assert(endianness() == "little" || endianness() == "big", equals(true))

  ~ Constants, so two reads always agree.
  assert(platform(), equals(platform()))

  0
>
