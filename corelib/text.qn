~ core.text — the self-hosted half of the built-in `Text` methods: the composable
~ methods, written in Quilon over the native grapheme primitives. Reference:
~ docs/types/text.md.
~
~ `Text` is conceptually a sequence of graphemes (`Text = []Grapheme`, a grapheme being a
~ length-1 `Text`), and the native surface is every operation that is either linear only
~ in bytes (segmentation, substring search, `split`, `replaceAll`, `replace`) or needs the
~ byte representation directly: `length`/`graphemes`/`at`, `indexOf`, grapheme-boundary
~ `slice`, the whitespace walks (`trimStart`/`trimEnd`), case mapping
~ (`toUpper`/`toLower`), comparison, and `+`. Everything else composes from those, here.
~
~ This module is the compiler's own, and pure implementation: no program imports it (a
~ written `<< core.text` is rejected), it exports nothing, and it binds no name. The
~ compiler merges it — under its qualified names — into any program that calls one of
~ the methods it implements, so `text.trim()` keeps working with no import, and member
~ syntax is the ONLY way these are reached. Each function takes the receiver as its
~ first parameter because that is a method's shape once compiled (`it` is the first
~ argument).
~
~ The module's own suite lives at the bottom (`quilon test corelib/text.qn`), which is
~ what `<< core.test` is for.

<< core.test

~ `half + half` — what squares the doubling walk below without a value position for a
~ block.
double = (half :: Text) -> Text => < half + half >

~ `count` (a whole number, 0 or more) copies of `t`, by binary doubling: log(count)
~ concatenations rather than count. The walk behind `repeat`; validation lives in the
~ entry point below. (`test.failAt` pads its frame with `.repeat` — those counts are
~ always valid, so a failing `repeat` reports once rather than recursing.)
copies = (t :: Text, count :: Num) -> Text => <
  count == 0
    ? ""
    : count % 2 == 1
      ? t + copies(t, count - 1)
      : double(copies(t, count / 2))
>

~ Strip leading and trailing whitespace: the two one-sided walks, composed.
trim = (t :: Text) -> Text => < t.trimStart().trimEnd() >

~ Whether `sub` occurs in `t`: where `indexOf` finds an index, `contains` is true.
contains = (t :: Text, sub :: Text) -> Bool => <
  t.indexOf(sub) ?
    | Ok(_)    => true
    | NotOk(_) => false
>

~ `count` copies of `t`, back to back; 0 yields `""`. Fails loudly (exit 5) on a
~ negative, fractional, or non-finite `count` — the checker rejects a literal one at
~ compile time, this is the backstop for a computed one.
repeat = (t :: Text, count :: Num, site :: Site) -> Text => <
  count >= 0 && count % 1 == 0
    ? $
    : test.failAt("repeat: ``count`` must be a whole number of 0 or more", site)
  copies(t, count)
>

~ ── The module's own suite ─────────────────────────────────────────────────────────
~ `repeat`'s fail-loud contract is exercised in `tests/text_methods_test.rs`, which pins
~ its exit code and message in full (`replace`/`replaceAll` are native and tested there
~ entirely, in `quilon-rt/src/text.rs` too).

test.describe("split", () => <
  test.it("splits on the separator", () => <
    pieces = "a,b,c".split(",")
    expect(pieces.size, equals(3))
    expect(pieces[0], equals("a"))
    expect(pieces[2], equals("c"))
  >)

  test.it("keeps the empty pieces between consecutive separators", () => <
    pieces = "a,,b".split(",")
    expect(pieces.size, equals(3))
    expect(pieces[1], equals(""))
  >)

  test.it("yields a single empty piece for an empty text", () => <
    pieces = "".split(",")
    expect(pieces.size, equals(1))
    expect(pieces[0], equals(""))
  >)

  test.it("splits on a multi-grapheme separator", () => <
    pieces = "Hello, World".split(", ")
    expect(pieces.size, equals(2))
    expect(pieces[1], equals("World"))
  >)

  test.it("splits an empty separator into graphemes", () => <
    graphemes = "héllo".split("")
    expect(graphemes.size, equals(5))
    expect(graphemes[1], equals("é"))
  >)

  test.it("has no graphemes to split an empty text into", () =>
    expect("".split("").size, equals(0)))
>)

test.describe("trim", () => <
  test.it("strips both ends, Unicode whitespace included", () =>
    expect(" héllo  ".trim(), equals("héllo")))

  test.it("leaves the middle alone", () =>
    expect("  a b  ".trim(), equals("a b")))
>)

test.describe("contains", () => <
  test.it("finds a substring", () => expect("haystack".contains("stack"), equals(true)))

  test.it("misses an absent one", () =>
    expect("haystack".contains("carrot"), equals(false)))

  test.it("contains the empty text", () => expect("x".contains(""), equals(true)))
>)

test.describe("repeat", () => <
  test.it("concatenates count copies", () => expect("^".repeat(3), equals("^^^")))

  test.it("yields the empty text for 0", () => expect("ab".repeat(0), equals("")))

  test.it("keeps grapheme clusters whole", () =>
    expect("é😀".repeat(3).length, equals(6)))
>)

test.describe("grapheme access", () => <
  test.it("at reads the grapheme, multibyte kept whole", () => <
    grapheme = "a🌍b".at(1) ?
      | Ok(g)    => g
      | NotOk(_) => ""
    expect(grapheme, equals("🌍"))
  >)

  test.it("at is NotOk out of bounds", () => expect("abc".at(3), isNotOk()))

  test.it("graphemes yields the cluster sequence", () => <
    graphemes = "héllo".graphemes()
    expect(graphemes.size, equals(5))
    expect(graphemes[1], equals("é"))
  >)
>)
