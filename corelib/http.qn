~ core.http — a minimal HTTP client built entirely on core.net's @tcpRequest. HTTP only,
~ no TLS. Import with `<< core.http`. Reference: docs/corelib/http.md.

<< core.net

~ A request body: the text to send and the media type to advertise for it.
>> Body = { content :: Text, contentType :: Text }

~ The HTTP method. Body-bearing methods carry a `Body`; the rest are nullary. `Query` is
~ RFC 10008's safe, idempotent method with a body.
>> Method = Get / Post(Body) / Put(Body) / Query(Body) / Delete / Head {
  ~ The token this method writes in a request line.
  token = () -> Text => it ?
    | Get      => "GET"
    | Post(_)  => "POST"
    | Put(_)   => "PUT"
    | Query(_) => "QUERY"
    | Delete   => "DELETE"
    | Head     => "HEAD"

  ~ The body this method carries — an empty one for the methods that carry none.
  payload = () -> Body => it ?
    | Post(carried)  => carried
    | Put(carried)   => carried
    | Query(carried) => carried
    | _              => Body { content = "", contentType = "" }

  ~ Whether this method defines a meaning for an enclosed body. Such a method sends
  ~ `Content-Length` even when its content is empty — servers answer a POST without one with
  ~ 411 — while the nullary methods send neither body header.
  carriesBody = () -> Bool => it ?
    | Post(_)  => true
    | Put(_)   => true
    | Query(_) => true
    | _        => false
}

~ A reply: the raw response text, read through the methods below.
>> Response = {
  raw :: Text,

  ~ Where the blank line separating head from body begins, or `raw.length` when the reply has
  ~ none. All four spellings of a blank line are measured and the earliest wins, so a body
  ~ carrying a blank line in the other convention cannot move the split. `split(x)[0].length`
  ~ is "where x first appears, or the whole length when it never does" — a reply with no
  ~ separator splits into one piece. Each spelling is exactly two graphemes, so the body starts
  ~ two past this index; searching `raw` directly keeps every offset in one index space.
  blankLine = () -> Num => <
    atCrlfCrlf = it.raw.split("\r\n\r\n")[0].length
    atLfLf = it.raw.split("\n\n")[0].length
    atCrlfLf = it.raw.split("\r\n\n")[0].length
    atLfCrlf = it.raw.split("\n\r\n")[0].length
    pureConvention = atCrlfCrlf < atLfLf ? atCrlfCrlf : atLfLf
    mixedConvention = atCrlfLf < atLfCrlf ? atCrlfLf : atLfCrlf
    pureConvention < mixedConvention ? pureConvention : mixedConvention
  >

  ~ Everything before the blank line — the status line and the header lines — with CRLF endings
  ~ rewritten to LF, so the methods below split on `\n` whichever convention the server used. A
  ~ reply with no blank line at all is all head and no body.
  head = () -> Text => it.raw.slice(0, it.blankLine()).replaceAll("\r\n", "\n")

  ~ The reply's first line, trimmed: `HTTP/1.1 200 OK`.
  statusLine = () -> Text => it.head().split("\n")[0].trim()

  ~ The header lines, trimmed and without the status line. A line carrying no colon is
  ~ not a header and is left out, so a garbled reply yields the headers it does have.
  headers = () -> []Text => <
    section = it.head()
    afterStatusLine = section.indexOf("\n") ?
      | Ok(mark) => section.slice(mark + 1, section.length)
      | NotOk(_) => ""
    afterStatusLine.split("\n").map(line => line.trim()).filter(line => line.contains(":"))
  >

  ~ The numeric status code (`HTTP/1.0 200 OK` -> 200), or 0 when the status line carries
  ~ no code that is digits throughout — a garbled reply reads as 0 rather than guessing.
  status = () -> Num => <
    digitOf = (grapheme :: Text) -> Result => "0123456789".indexOf(grapheme)
    isDigit = (grapheme :: Text) -> Bool => digitOf(grapheme) ?
      | Ok(_)    => true
      | NotOk(_) => false
    fields = it.statusLine().split(" ")
    code = fields.size > 1 ? fields[1] : ""
    graphemes = code.split("")
    allDigits = code.length > 0
      && graphemes.filter(grapheme => isDigit(grapheme)).size == graphemes.size
    allDigits
      ? graphemes.reduce(0, (accumulator, grapheme) => digitOf(grapheme) ?
        | Ok(digit) => accumulator * 10 + digit
        | NotOk(_)  => accumulator)
      : 0
  >

  ~ Look up a header by name, case-insensitively: `Ok(value)` or `NotOk(name)`. The value
  ~ is trimmed, so `X-Empty:` yields `Ok("")`; when a name repeats, the first line wins.
  header = (name :: Text) -> Result => <
    wanted = name.trim().toLower()
    ~ Every line `headers()` yields carries a colon, so splitting on it always has a name.
    nameOf = (line :: Text) -> Text => line.split(":")[0].trim().toLower()
    valueOf = (line :: Text) -> Text => line.indexOf(":") ?
      | Ok(colon) => line.slice(colon + 1, line.length).trim()
      | NotOk(_)  => ""
    it.headers().find(line => nameOf(line) == wanted) ?
      | Ok(line) => Ok(valueOf(line))
      | NotOk(_) => NotOk(name)
  >

  ~ Everything after the blank line, sliced out of the RAW text so a body carrying its own CRLF
  ~ survives intact; "" for a reply with no blank line. `Content-Length` is never consulted —
  ~ the close delimits the body.
  body = () -> Text => <
    mark = it.blankLine()
    mark < it.raw.length ? it.raw.slice(mark + 2, it.raw.length) : ""
  >
}

~ Wrap raw response text as a `Response`, rejecting a reply with no HTTP status line:
~ `Ok(Response)` / `NotOk(errorText)`.
>> parseResponse = (raw :: Text) -> Result =>
  raw.slice(0, 4) == "HTTP" && raw.contains("\n")
    ? Ok(Response { raw = raw })
    : NotOk("malformed HTTP response")

~ A request: the method and the target URL (`http://host[:port]/path`, scheme optional).
>> Request = {
  method :: Method,
  url :: Text,

  ~ The URL with any `scheme://` prefix removed: `host[:port]/path`.
  withoutScheme = () -> Text => it.url.indexOf("://") ?
    | Ok(mark) => it.url.slice(mark + 3, it.url.length)
    | NotOk(_) => it.url

  ~ Where the authority ends: the first `/`, `?` or `#`, or the whole string for a bare host.
  ~ Cutting at all three keeps a query string out of the host — `example.com?a=b` is the host
  ~ `example.com` asking for `/?a=b`, not a host named `example.com?a=b`.
  authorityEnd = () -> Num => <
    rest = it.withoutScheme()
    atPath = rest.split("/")[0].length
    atQuery = rest.split("?")[0].length
    atFragment = rest.split("#")[0].length
    nearest = atPath < atQuery ? atPath : atQuery
    nearest < atFragment ? nearest : atFragment
  >

  ~ The `host[:port]` to connect to, and what the `Host` header carries. Any `userinfo@` prefix
  ~ is dropped: it is a credential, not part of the host.
  authority = () -> Text => <
    named = it.withoutScheme().slice(0, it.authorityEnd())
    parts = named.split("@")
    parts[parts.size - 1]
  >

  ~ The path the request line asks for, with a bare query string given the `/` root it implies
  ~ and any `#fragment` dropped — a fragment never goes on the wire. `/` when the URL carries
  ~ no path at all.
  path = () -> Text => <
    rest = it.withoutScheme()
    start = it.authorityEnd()
    end = rest.split("#")[0].length
    target = start < end ? rest.slice(start, end) : ""
    target == "" ? "/" : (target.slice(0, 1) == "/" ? target : "/" + target)
  >

  ~ The request serialised to the text that goes on the wire. A body-bearing method adds
  ~ `Content-Type` and a `Content-Length` counted in BYTES — even for empty content, which is a
  ~ body of length zero rather than no body — then the body after the blank line.
  wire = () -> Text => <
    carried = it.method.payload()
    requestLine = "`it.method.token()` `it.path()` HTTP/1.0\r\n"
    headers = "Host: `it.authority()`\r\nConnection: close\r\n"
    bodyHeaders = it.method.carriesBody()
      ? "Content-Type: `carried.contentType`\r\nContent-Length: `carried.content.size`\r\n"
      : ""
    requestLine + headers + bodyHeaders + "\r\n" + carried.content
  >

  ~ Perform the request over core.net and read the reply into `Ok(Response)`; a transport
  ~ failure arrives as the `NotOk(errorText)` the primitive reported, never as a crash.
  send = () -> Result => <
    host = it.authority()
    address = host.contains(":") ? host : host + ":80"
    @tcpRequest(address, it.wire()) ?
      | Ok(responseText) => parseResponse(responseText)
      | NotOk(problem)   => NotOk(problem)
  >
}

~ Fetch a URL with a GET request: `Ok(Response)` / `NotOk(errorText)`.
>> get = (url :: Text) -> Result => Request { method = Get, url = url }.send()
