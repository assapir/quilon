~ core.http — a minimal HTTP client built entirely on core.net's @tcpRequest. HTTP only,
~ no TLS. Import with `<< core.http`. Reference: docs/corelib/http.md.

<< core.net

~ A request body: the text to send and the media type to advertise for it.
>> Body = { content :: Text, contentType :: Text }

~ A multi-value name/value store: every value under a name is kept, in the order added
~ (HTTP treats `X-A: 1` + `X-A: 2` as one name with two values). `Headers` and `Params`
~ each hold one and delegate, so the append/lookup logic lives here once.
Values = {
  entries :: [|Text => []Text|],

  empty = () -> Values => < Values { entries = [|=>|] } >,

  ~ Every value under `name`, in the order added; `[]` when absent.
  all = (name :: Text) -> []Text => <
    none :: []Text = []
    it.entries.get(name) ?
      | Ok(list) => list
      | NotOk(_) => none
  >,

  ~ The first value under `name`, or `NotOk(name)` when absent.
  get = (name :: Text) -> Result => <
    list = it.all(name)
    list.size > 0 ? Ok(list[0]) : NotOk(name)
  >,

  has = (name :: Text) -> Bool => < it.entries.has(name) >,

  names = () -> []Text => < it.entries.keys() >,

  ~ Append one value under `name`, keeping any values already there.
  add := (name :: Text, value :: Text) -> $ => <
    it.entries.set(name, [<-it.all(name), value])
    $
  >,

  ~ Append every entry of `entries`, one name at a time.
  add := (entries :: [|Text => Text|]) -> $ => <
    entries.keys().each(name => <
      value :: Text = entries.get(name) ? | Ok(v) => v | NotOk(_) => ""
      it.entries.set(name, [<-it.all(name), value])
    >)
    $
  >
}

~ Request/response headers: names are lower-cased, HTTP/2 style, before every lookup or
~ append, so `add("X-Trace", "abc")` and a later `get("x-trace")` agree.
>> Headers = {
  values :: Values,

  empty = () -> Headers => < Headers { values = Values.empty() } >,

  get = (name :: Text) -> Result => < it.values.get(name.trim().toLower()) >,
  all = (name :: Text) -> []Text => < it.values.all(name.trim().toLower()) >,
  has = (name :: Text) -> Bool => < it.values.has(name.trim().toLower()) >,

  ~ Every header name present, already lower-cased.
  names = () -> []Text => < it.values.names() >,

  add := (name :: Text, value :: Text) -> $ => <
    it.values.add(name.trim().toLower(), value)
    $
  >,

  ~ Lower-cases each name before delegating, so this can't just forward the map whole.
  add := (headers :: [|Text => Text|]) -> $ => <
    headers.keys().each(name => <
      value :: Text = headers.get(name) ? | Ok(v) => v | NotOk(_) => ""
      it.values.add(name.trim().toLower(), value)
    >)
    $
  >,

  ~ One `name: value\r\n` line per value.
  wire = () -> Text => <
    it.names().reduce("", (acc, name) =>
      acc + it.all(name).reduce("", (lines, value) => lines + name + ": " + value + "\r\n"))
  >,

  ~ Headers parsed from trimmed `Name: value` lines: names lower-cased, values trimmed, a
  ~ colon inside a value kept (only the first colon splits a line).
  parse = (lines :: []Text) -> Headers => <
    headers := Headers.empty()
    lines.each(line => <
      line.indexOf(":") ?
        | Ok(colon) =>
          headers.add(line.slice(0, colon).trim(), line.slice(colon + 1, line.length).trim())
        | NotOk(_) => $
    >)
    headers
  >
}

~ A URL's query parameters, name-sensitive (unlike `Headers`): `add`/`get`/`all` compare
~ names exactly as written. No percent-encoding on the way out or decoding on the way in.
>> Params = {
  values :: Values,

  empty = () -> Params => < Params { values = Values.empty() } >,

  get = (name :: Text) -> Result => < it.values.get(name) >,
  all = (name :: Text) -> []Text => < it.values.all(name) >,
  has = (name :: Text) -> Bool => < it.values.has(name) >,
  names = () -> []Text => < it.values.names() >,

  add := (name :: Text, value :: Text) -> $ => <
    it.values.add(name, value)
    $
  >,
  add := (params :: [|Text => Text|]) -> $ => <
    it.values.add(params)
    $
  >,

  ~ `a=1&b=2` style, split on `&` then each pair's first `=`; a bare name (no `=`) is a
  ~ value of `""`. An empty query parses to no params at all.
  parse = (query :: Text) -> Params => <
    params := Params.empty()
    query.split("&").filter(pair => pair != "").each(pair => <
      pair.indexOf("=") ?
        | Ok(mark) => params.add(pair.slice(0, mark), pair.slice(mark + 1, pair.length))
        | NotOk(_) => params.add(pair, "")
    >)
    params
  >
}

~ Per-request settings beyond method and URL — headers today, room for more later without
~ changing `Request`'s own shape.
>> RequestOptions = {
  headers :: Headers,

  default = () -> RequestOptions => < RequestOptions { headers = Headers.empty() } >
}

~ The HTTP method. Body-bearing methods carry a `Body`; the rest are nullary. `Query` is
~ RFC 10008's safe, idempotent method with a body.
>> Method = Get / Post(Body) / Put(Body) / Query(Body) / Delete / Head / Options / Patch(Body) {
  ~ The token this method writes in a request line.
  token = () -> Text => <
    it ?
      | Get      => "GET"
      | Post(_)  => "POST"
      | Put(_)   => "PUT"
      | Query(_) => "QUERY"
      | Delete   => "DELETE"
      | Head     => "HEAD"
      | Options  => "OPTIONS"
      | Patch(_) => "PATCH"
  >

  ~ The body this method carries — an empty one for the methods that carry none.
  payload = () -> Body => <
    it ?
      | Post(carried)  => carried
      | Put(carried)   => carried
      | Query(carried) => carried
      | Patch(carried) => carried
      | _              => Body { content = "", contentType = "" }
  >

  ~ Whether this method defines a meaning for an enclosed body. Such a method sends
  ~ `Content-Length` even when its content is empty — servers answer a POST without one with
  ~ 411 — while the nullary methods send neither body header.
  carriesBody = () -> Bool => <
    it ?
      | Post(_)  => true
      | Put(_)   => true
      | Query(_) => true
      | Patch(_) => true
      | _        => false
  >
}

~ core.http's native body-framing primitive: locate the head/body blank line on RAW bytes,
~ then dechunk, take exactly `contentLength` bytes, or close-delimit, given what the head
~ already established. Compiler-lowered — the body below is an inert placeholder (it only
~ pins the checker's inferred `Result` payload type to `Text`); the byte-level work — where a
~ chunk or a `Content-Length` count can cut a multi-byte character in two, a split Quilon's
~ grapheme-indexed `Text` cannot express — is a runtime intrinsic instead.
frameBody = (raw :: Text, bodiless :: Bool, transferEncoding :: Text, contentLength :: Text) -> Result => <
  bodiless ? Ok("") : NotOk("")
>

~ A reply: the raw response text, read through the methods below.
>> Response = {
  raw :: Text,

  ~ Reject a reply that does not open with an HTTP status line: `Ok(it)` for a reply worth
  ~ reading, `NotOk(errorText)` for one that is not HTTP at all.
  validate = () -> Result => <
    it.raw.slice(0, 4) == "HTTP" && it.raw.contains("\n")
      ? Ok(it)
      : NotOk("malformed HTTP response")
  >

  ~ Where the blank line separating head from body begins, or `raw.length` when the reply has
  ~ none. All four spellings of a blank line are measured and the earliest wins, so a body
  ~ carrying a blank line in the other convention cannot move the split. `split(x)[0].length`
  ~ is "where x first appears, or the whole length when it never does" — a reply with no
  ~ separator splits into one piece. Each spelling is exactly two graphemes, so the body starts
  ~ two past this index; searching `raw` directly keeps every offset in one index space.
  blankLine = () -> Num => <
    atCrlfCrlf = it.raw.split("\r\n\r\n")[0].length
    atLfLf = it.raw.split("\n\n")[0].length
    atCrlfLf = it.raw.split("\r\n\n")[0].length
    atLfCrlf = it.raw.split("\n\r\n")[0].length
    pureConvention = atCrlfCrlf < atLfLf ? atCrlfCrlf : atLfLf
    mixedConvention = atCrlfLf < atLfCrlf ? atCrlfLf : atLfCrlf
    pureConvention < mixedConvention ? pureConvention : mixedConvention
  >

  ~ Everything before the blank line — the status line and the header lines — with CRLF endings
  ~ rewritten to LF, so the methods below split on `\n` whichever convention the server used. A
  ~ reply with no blank line at all is all head and no body.
  head = () -> Text => < it.raw.slice(0, it.blankLine()).replaceAll("\r\n", "\n") >

  ~ The reply's first line, trimmed: `HTTP/1.1 200 OK`.
  statusLine = () -> Text => < it.head().split("\n")[0].trim() >

  ~ The reply's headers, parsed off the lines between the status line and the blank line. A
  ~ line carrying no colon is not a header and is left out, so a garbled reply yields the
  ~ headers it does have.
  headers = () -> Headers => <
    section = it.head()
    afterStatusLine = section.indexOf("\n") ?
      | Ok(mark) => section.slice(mark + 1, section.length)
      | NotOk(_) => ""
    lines = afterStatusLine.split("\n").map(line => line.trim()).filter(line => line.contains(":"))
    Headers.parse(lines)
  >

  ~ The numeric status code (`HTTP/1.0 200 OK` -> 200), or 0 when the status line carries
  ~ no code that is digits throughout — a garbled reply reads as 0 rather than guessing.
  status = () -> Num => <
    digitOf = (grapheme :: Text) -> Result => < "0123456789".indexOf(grapheme) >
    isDigit = (grapheme :: Text) -> Bool => <
      digitOf(grapheme) ?
        | Ok(_)    => true
        | NotOk(_) => false
    >
    fields = it.statusLine().split(" ")
    code = fields.size > 1 ? fields[1] : ""
    graphemes = code.split("")
    allDigits = code.length > 0
      && graphemes.filter(grapheme => isDigit(grapheme)).size == graphemes.size
    allDigits
      ? graphemes.reduce(0, (accumulator, grapheme) => digitOf(grapheme) ?
        | Ok(digit) => accumulator * 10 + digit
        | NotOk(_)  => accumulator)
      : 0
  >

  ~ Whether this reply carries no body regardless of what its headers claim: an informational
  ~ (1xx), a 204, or a 304 status.
  bodiless = () -> Bool => <
    code = it.status()
    (code >= 100 && code < 200) || code == 204 || code == 304
  >

  ~ The framed body as a `Result`: `Ok(bodyBytes)` when the reply's declared framing —
  ~ chunked, `Content-Length`, or close-delimited — is well-formed, `NotOk(reason)` when it
  ~ is not. `body()` and `send()`'s framing check both read this; `body()` masks a `NotOk`
  ~ to `""`, `send()` surfaces it.
  bodyResult = () -> Result => <
    transferEncoding = it.headers().get("transfer-encoding") ?
      | Ok(value) => value
      | NotOk(_)  => ""
    contentLength = it.headers().get("content-length") ?
      | Ok(value) => value
      | NotOk(_)  => ""
    frameBody(it.raw, it.bodiless(), transferEncoding, contentLength)
  >

  ~ The reply's body: dechunked when `Transfer-Encoding: chunked`, exactly `Content-Length`
  ~ bytes when one is given, else everything after the blank line (close-delimited). A
  ~ malformed framing reads as `""` rather than a partial or corrupt body — `send()` is
  ~ where that failure surfaces as `NotOk`.
  body = () -> Text => <
    it.bodyResult() ?
      | Ok(bytes) => bytes
      | NotOk(_)  => ""
  >

  ~ Whether this reply's body framing is well-formed. `skip` is true for a HEAD reply,
  ~ whose Content-Length describes a body that is never sent, so the check does not apply:
  ~ `Ok(it)` when the check passes or is skipped, `NotOk(reason)` when it does not.
  framingOk = (skip :: Bool) -> Result => <
    skip
      ? Ok(it)
      : (it.bodyResult() ?
          | Ok(_)         => Ok(it)
          | NotOk(reason) => NotOk(reason))
  >
}

~ A request: the method, the target URL (`http://host[:port]/path`, scheme optional), and
~ its options (headers today).
>> Request = {
  method :: Method,
  url :: Text,
  options :: RequestOptions,

  get = (url :: Text) -> Request => < Request { method = Get, url = url, options = RequestOptions.default() } >,
  get = (url :: Text, options :: RequestOptions) -> Request => < Request { method = Get, url = url, options = options } >,

  head = (url :: Text) -> Request => < Request { method = Head, url = url, options = RequestOptions.default() } >,
  head = (url :: Text, options :: RequestOptions) -> Request => < Request { method = Head, url = url, options = options } >,

  delete = (url :: Text) -> Request => < Request { method = Delete, url = url, options = RequestOptions.default() } >,
  delete = (url :: Text, options :: RequestOptions) -> Request => < Request { method = Delete, url = url, options = options } >,

  ~ The OPTIONS method constructor: a dot-call (`Request.options(url)`) reaches this; a bare
  ~ access on a value (`request.options`) reaches the `options` FIELD instead.
  options = (url :: Text) -> Request => < Request { method = Options, url = url, options = RequestOptions.default() } >,
  options = (url :: Text, options :: RequestOptions) -> Request => < Request { method = Options, url = url, options = options } >,

  post = (url :: Text, body :: Body) -> Request => < Request { method = Post(body), url = url, options = RequestOptions.default() } >,
  post = (url :: Text, body :: Body, options :: RequestOptions) -> Request => < Request { method = Post(body), url = url, options = options } >,

  put = (url :: Text, body :: Body) -> Request => < Request { method = Put(body), url = url, options = RequestOptions.default() } >,
  put = (url :: Text, body :: Body, options :: RequestOptions) -> Request => < Request { method = Put(body), url = url, options = options } >,

  patch = (url :: Text, body :: Body) -> Request => < Request { method = Patch(body), url = url, options = RequestOptions.default() } >,
  patch = (url :: Text, body :: Body, options :: RequestOptions) -> Request => < Request { method = Patch(body), url = url, options = options } >,

  query = (url :: Text, body :: Body) -> Request => < Request { method = Query(body), url = url, options = RequestOptions.default() } >,
  query = (url :: Text, body :: Body, options :: RequestOptions) -> Request => < Request { method = Query(body), url = url, options = options } >,

  ~ The URL with any `scheme://` prefix removed: `host[:port]/path`.
  withoutScheme = () -> Text => <
    it.url.indexOf("://") ?
      | Ok(mark) => it.url.slice(mark + 3, it.url.length)
      | NotOk(_) => it.url
  >

  ~ Where the authority ends: the first `/`, `?` or `#`, or the whole string for a bare host.
  ~ Cutting at all three keeps a query string out of the host — `example.com?a=b` is the host
  ~ `example.com` asking for `/?a=b`, not a host named `example.com?a=b`.
  authorityEnd = () -> Num => <
    rest = it.withoutScheme()
    atPath = rest.split("/")[0].length
    atQuery = rest.split("?")[0].length
    atFragment = rest.split("#")[0].length
    nearest = atPath < atQuery ? atPath : atQuery
    nearest < atFragment ? nearest : atFragment
  >

  ~ The `host[:port]` to connect to, and what the `Host` header carries. Any `userinfo@` prefix
  ~ is dropped: it is a credential, not part of the host.
  authority = () -> Text => <
    named = it.withoutScheme().slice(0, it.authorityEnd())
    parts = named.split("@")
    parts[parts.size - 1]
  >

  ~ The path the request line asks for, with a bare query string given the `/` root it implies
  ~ and any `#fragment` dropped — a fragment never goes on the wire. `/` when the URL carries
  ~ no path at all.
  path = () -> Text => <
    rest = it.withoutScheme()
    start = it.authorityEnd()
    end = rest.split("#")[0].length
    target = start < end ? rest.slice(start, end) : ""
    target == "" ? "/" : (target.slice(0, 1) == "/" ? target : "/" + target)
  >

  ~ The URL's query string, parsed into `Params` — `[]` when the URL carries none.
  params = () -> Params => <
    target = it.path()
    target.indexOf("?") ?
      | Ok(mark) => Params.parse(target.slice(mark + 1, target.length))
      | NotOk(_) => Params.empty()
  >

  ~ The request's own headers (empty unless a constructor was given options carrying some).
  headers = () -> Headers => < it.options.headers >

  ~ The request serialised to the text that goes on the wire. A body-bearing method adds
  ~ `content-type` and a `content-length` counted in BYTES — even for empty content, which is
  ~ a body of length zero rather than no body — then the caller's own headers, then the body
  ~ after the blank line. A caller header sharing a generated name (`host`, `connection`,
  ~ `content-type`, `content-length`) replaces that generated line rather than duplicating it.
  wire = () -> Text => <
    carried = it.method.payload()
    requestLine = "`it.method.token()` `it.path()` HTTP/1.1\r\n"
    given = it.headers()
    hostLine = given.has("host") ? "" : "host: `it.authority()`\r\n"
    connectionLine = given.has("connection") ? "" : "connection: close\r\n"
    contentTypeLine = it.method.carriesBody() && !given.has("content-type")
      ? "content-type: `carried.contentType`\r\n"
      : ""
    contentLengthLine = it.method.carriesBody() && !given.has("content-length")
      ? "content-length: `carried.content.size`\r\n"
      : ""
    requestLine + hostLine + connectionLine + contentTypeLine + contentLengthLine
      + given.wire() + "\r\n" + carried.content
  >

  ~ Perform the request over core.net and read the reply into `Ok(Response)`: the status
  ~ line validates, and the body's framing (chunked or Content-Length) must be well-formed —
  ~ a HEAD reply's Content-Length, which describes a body that is never sent, is exempt. A
  ~ transport failure, an invalid status line, or malformed framing all arrive as the
  ~ `NotOk(errorText)` reason, never as a crash.
  send = () -> Result => <
    host = it.authority()
    address = host.contains(":") ? host : host + ":80"
    @tcpRequest(address, it.wire()) ?
      | Ok(responseText) => (Response { raw = responseText }.validate() ?
          | Ok(response)   => response.framingOk(it.method.token() == "HEAD")
          | NotOk(problem) => NotOk(problem))
      | NotOk(problem)   => NotOk(problem)
  >
}

~ The suite for everything above: every parser and serialiser edge case, offline over canned
~ `Text`, so it runs anywhere. Only `quilon test corelib/http.qn` compiles these blocks — every
~ other command erases them, and the fixtures below carry no `>>`, so a program importing
~ `core.http` never sees them. The harness follows the blocks: nothing outside one names it,
~ so no build it does not belong in emits it.
<< core.test

~ A well-formed CRLF reply with two headers and a five-character body.
crlfReply = () -> Text => <
  "HTTP/1.1 200 OK\r\nContent-Type: text/html\r\nContent-Length: 5\r\n\r\nhello"
>

~ The same reply with bare LF endings, as a sloppy server writes it.
lineFeedReply = () -> Text => <
  "HTTP/1.1 200 OK\nContent-Type: text/html\nContent-Length: 5\n\nhello"
>

~ Read a header, or a marker when it is absent, so a case can assert on plain `Text`.
headerOr = (response :: Response, name :: Text, fallback :: Text) -> Text => <
  response.headers().get(name) ?
    | Ok(value) => value
    | NotOk(_)  => fallback
>

~ Parse a reply the case knows is well-formed. `assert`, not `expect`: an unparseable fixture
~ is a broken test rather than a failed case.
parsed = (raw :: Text) -> Response => <
  candidate = Response { raw = raw }
  assert(candidate.validate(), isOk())
  candidate.validate() ?
    | Ok(response) => response
    | NotOk(_)     => candidate
>

test.describe("validating a reply", () => <
  test.it("rejects a reply that is not HTTP at all", () =>
    expect(Response { raw = "not http at all\r\n\r\n" }.validate(), isNotOk()))

  test.it("rejects a reply with no line ending", () =>
    expect(Response { raw = "HTTP/1.1 200 OK" }.validate(), isNotOk()))

  test.it("rejects an empty reply", () => expect(Response { raw = "" }.validate(), isNotOk()))
>)

test.describe("the status line", () => <
  test.it("reads the code of a normal reply", () =>
    expect(parsed(crlfReply()).status(), equals(200)))

  test.it("hands back the whole line, trimmed", () =>
    expect(parsed(crlfReply()).statusLine(), equals("HTTP/1.1 200 OK")))

  test.it("accepts HTTP/1.0", () =>
    expect(parsed("HTTP/1.0 301 Moved\r\n\r\n").status(), equals(301)))

  test.it("accepts HTTP/1.1", () =>
    expect(parsed("HTTP/1.1 301 Moved\r\n\r\n").status(), equals(301)))

  test.it("reads a code with no reason phrase", () =>
    expect(parsed("HTTP/1.1 204\r\n\r\n").status(), equals(204)))

  test.it("reads a non-numeric code as 0 rather than guessing", () => <
    ~ The letter O for a zero: no digit-salvaging, no plausible wrong number.
    garbled = Response { raw = "HTTP/1.1 2O0 OK\r\n\r\n" }
    expect(garbled.status(), equals(0))
  >)

  test.it("reads a missing code as 0", () => <
    bare = Response { raw = "HTTP/1.1\r\n\r\n" }
    expect(bare.status(), equals(0))
  >)

  test.it("reads a garbage first line as 0", () => <
    garbage = Response { raw = "!!!\r\n\r\n" }
    expect(garbage.status(), equals(0))
  >)
>)

test.describe("headers", () => <
  test.it("finds a header by its exact name", () =>
    expect(headerOr(parsed(crlfReply()), "Content-Type", "absent"), equals("text/html")))

  test.it("looks a header up case-insensitively", () =>
    expect(headerOr(parsed(crlfReply()), "content-type", "absent"), equals("text/html")))

  test.it("looks a header up whatever the mix of cases", () =>
    expect(headerOr(parsed(crlfReply()), "CoNtEnT-tYpE", "absent"), equals("text/html")))

  test.it("trims the name it is asked for", () =>
    expect(headerOr(parsed(crlfReply()), "  Content-Type  ", "absent"), equals("text/html")))

  test.it("reports an absent header as NotOk", () =>
    expect(parsed(crlfReply()).headers().get("X-Absent"), isNotOk()))

  test.it("keeps the first of two headers with one name", () => <
    twice = parsed("HTTP/1.1 200 OK\r\nX-Pick: first\r\nX-Pick: second\r\n\r\n")
    expect(headerOr(twice, "x-pick", "absent"), equals("first"))
  >)

  test.it("keeps every value of a header with one name", () => <
    twice = parsed("HTTP/1.1 200 OK\r\nX-Pick: first\r\nX-Pick: second\r\n\r\n")
    expect(twice.headers().all("x-pick").size, equals(2))
  >)

  test.it("reads a header with no value as an empty value", () => <
    empty = parsed("HTTP/1.1 200 OK\r\nX-Empty:\r\n\r\n")
    expect(empty.headers().get("X-Empty"), isOk())
    expect(headerOr(empty, "X-Empty", "absent"), equals(""))
  >)

  test.it("trims whitespace around the colon and the value", () => <
    padded = parsed("HTTP/1.1 200 OK\r\nX-Pad :   spaced out   \r\n\r\n")
    expect(headerOr(padded, "x-pad", "absent"), equals("spaced out"))
  >)

  test.it("keeps a colon inside a header value", () => <
    dated = parsed("HTTP/1.1 200 OK\r\nDate: Tue, 01 Jan 2030 10:20:30 GMT\r\n\r\n")
    expect(headerOr(dated, "date", "absent"), equals("Tue, 01 Jan 2030 10:20:30 GMT"))
  >)

  test.it("ignores a body line that looks like a header", () => <
    sneaky = parsed("HTTP/1.1 200 OK\r\nX-Real: yes\r\n\r\nX-Body: no")
    expect(sneaky.headers().get("X-Real"), isOk())
    expect(sneaky.headers().get("X-Body"), isNotOk())
  >)

  test.it("leaves a line carrying no colon out of the headers", () => <
    junk = parsed("HTTP/1.1 200 OK\r\ngarbage line\r\nX-Real: yes\r\n\r\n")
    expect(junk.headers().names().size, equals(1))
    expect(headerOr(junk, "x-real", "absent"), equals("yes"))
  >)

  test.it("lists every header name without the status line", () => <
    two = parsed(crlfReply())
    expect(two.headers().names().size, equals(2))
    expect(headerOr(two, "content-type", "absent"), equals("text/html"))
  >)

  test.it("finds no headers in a reply that has none", () =>
    expect(parsed("HTTP/1.1 200 OK\r\n\r\nbody").headers().names().size, equals(0)))
>)

test.describe("the body", () => <
  test.it("reads the text after the blank line", () =>
    expect(parsed(crlfReply()).body(), equals("hello")))

  test.it("reads an empty body as empty", () =>
    expect(parsed("HTTP/1.1 204 No Content\r\nX-A: b\r\n\r\n").body(), equals("")))

  test.it("keeps a CRLF inside the body intact", () => <
    multiline = parsed("HTTP/1.1 200 OK\r\nX-A: b\r\n\r\nfirst\r\nsecond\r\n\r\nthird")
    expect(multiline.body(), equals("first\r\nsecond\r\n\r\nthird"))
  >)

  test.it("reads no body at all when the reply has no blank line", () => <
    truncated = parsed("HTTP/1.1 200 OK\r\nContent-Type: text/html\r\n")
    expect(truncated.body(), equals(""))
    ~ The headers are still readable: the whole reply is head.
    expect(headerOr(truncated, "content-type", "absent"), equals("text/html"))
  >)

  test.it("returns the body with no Content-Length to go by", () =>
    expect(parsed("HTTP/1.1 200 OK\r\nX-A: b\r\n\r\npayload").body(), equals("payload")))

  test.it("takes exactly zero bytes for a Content-Length of zero", () => <
    empty = parsed("HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\npayload")
    expect(empty.body(), equals(""))
  >)

  test.it("takes exactly Content-Length bytes, dropping what follows", () => <
    short = parsed("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\npayload")
    expect(short.body(), equals("pa"))
  >)

  test.it("reads as empty a Content-Length longer than the bytes present", () => <
    ~ A short reply this way is malformed framing (`send()` is where that surfaces as
    ~ `NotOk`); `body()` alone has no failure channel, so it reads as empty rather than
    ~ handing back a partial, truncated body.
    long = parsed("HTTP/1.1 200 OK\r\nContent-Length: 999\r\n\r\npayload")
    expect(long.body(), equals(""))
  >)

  test.it("dechunks a chunked reply", () =>
    expect(
      parsed("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n").body(),
      equals("hello")))

  test.it("dechunks several chunks", () =>
    expect(
      parsed("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n2\r\nhe\r\n3\r\nllo\r\n0\r\n\r\n")
        .body(),
      equals("hello")))

  test.it("ignores a chunk's extensions", () =>
    expect(
      parsed("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5;foo=bar\r\nhello\r\n0\r\n\r\n")
        .body(),
      equals("hello")))

  test.it("drops trailers after the terminating chunk", () =>
    expect(
      parsed(
        "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\nX-Trailer: t\r\n\r\n")
        .body(),
      equals("hello")))

  test.it("reads a malformed chunk as an empty body", () => <
    ~ "ZZ" is not a hex chunk size — `send()` is where that surfaces as `NotOk`.
    malformed =
      parsed("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\nZZ\r\nhello\r\n0\r\n\r\n")
    expect(malformed.body(), equals(""))
  >)

  test.it("carries no body for a 204 with a Content-Length", () => <
    ~ A 204 is bodiless regardless of what its headers claim.
    noContent = parsed("HTTP/1.1 204 No Content\r\nContent-Length: 1234\r\n\r\n")
    expect(noContent.body(), equals(""))
  >)
>)

test.describe("line endings", () => <
  test.it("reads a bare-LF reply's status line", () =>
    expect(parsed(lineFeedReply()).statusLine(), equals("HTTP/1.1 200 OK")))

  test.it("reads a bare-LF reply's status code", () =>
    expect(parsed(lineFeedReply()).status(), equals(200)))

  test.it("reads a bare-LF reply's headers", () => <
    reply = parsed(lineFeedReply())
    expect(reply.headers().names().size, equals(2))
    expect(headerOr(reply, "content-type", "absent"), equals("text/html"))
  >)

  test.it("reads a bare-LF reply's body", () =>
    expect(parsed(lineFeedReply()).body(), equals("hello")))

  test.it("splits at the first blank line when the body carries a CRLF one", () => <
    ~ LF headers, and a CRLF blank line inside the body: taking CRLF on sight would put
    ~ the split inside the body and swallow most of it into the head.
    mixed = parsed("HTTP/1.1 200 OK\nX-A: b\n\nbody with \r\n\r\n inside")
    expect(mixed.statusLine(), equals("HTTP/1.1 200 OK"))
    expect(mixed.headers().names().size, equals(1))
    expect(mixed.body(), equals("body with \r\n\r\n inside"))
  >)

  test.it("splits correctly when a header line ends in a stray CR", () => <
    ~ `bar\r\r\n` is a malformed header line: the lone CR and the CRLF are two graphemes, but
    ~ rewriting CRLF to LF would fuse them into one and shift every later offset by one, so the
    ~ separator is located in the raw text instead.
    strayCarriageReturn =
      parsed("HTTP/1.1 200 OK\r\nX-Foo: bar\r\r\nContent-Type: t\r\n\r\nbody")
    expect(strayCarriageReturn.body(), equals("body"))
    expect(strayCarriageReturn.status(), equals(200))
  >)

  test.it("splits at the first blank line when the body carries a bare-LF one", () => <
    ~ The mirror case: CRLF headers, a bare-LF blank line in the body.
    mixed = parsed("HTTP/1.1 200 OK\r\nX-A: b\r\n\r\nbody with \n\n inside")
    expect(mixed.headers().names().size, equals(1))
    expect(mixed.body(), equals("body with \n\n inside"))
  >)

  test.it("agrees with the CRLF reply field for field", () => <
    crlf = parsed(crlfReply())
    lineFeed = parsed(lineFeedReply())
    expect(lineFeed.statusLine(), equals(crlf.statusLine()))
    expect(lineFeed.status(), equals(crlf.status()))
    expect(lineFeed.body(), equals(crlf.body()))
    expect(headerOr(lineFeed, "content-type", "?"), equals(headerOr(crlf, "content-type", "!")))
  >)
>)

test.describe("the Method sum", () => <
  test.it("writes GET", () => expect(Get.token(), equals("GET")))
  test.it("writes DELETE", () => expect(Delete.token(), equals("DELETE")))
  test.it("writes HEAD", () => expect(Head.token(), equals("HEAD")))
  test.it("writes OPTIONS", () => expect(Options.token(), equals("OPTIONS")))

  test.it("writes POST", () =>
    expect(Post(Body { content = "x", contentType = "text/plain" }).token(), equals("POST")))

  test.it("writes PUT", () =>
    expect(Put(Body { content = "x", contentType = "text/plain" }).token(), equals("PUT")))

  test.it("writes QUERY", () =>
    expect(Query(Body { content = "x", contentType = "text/plain" }).token(), equals("QUERY")))

  test.it("writes PATCH", () =>
    expect(Patch(Body { content = "x", contentType = "text/plain" }).token(), equals("PATCH")))

  test.it("carries the body of a body-bearing method", () => <
    carried = Post(Body { content = "sent", contentType = "text/plain" }).payload()
    expect(carried.content, equals("sent"))
    expect(carried.contentType, equals("text/plain"))
  >)

  test.it("carries the body of a PATCH", () => <
    carried = Patch(Body { content = "sent", contentType = "text/plain" }).payload()
    expect(carried.content, equals("sent"))
  >)

  test.it("carries an empty body for a nullary method", () => <
    none = Get.payload()
    expect(none.content, equals(""))
    expect(none.contentType, equals(""))
  >)

  test.it("treats PATCH like POST for carriesBody", () =>
    expect(Patch(Body { content = "x", contentType = "text/plain" }).carriesBody(), equals(true)))

  test.it("treats OPTIONS like the other nullary methods for carriesBody", () =>
    expect(Options.carriesBody(), equals(false)))
>)

test.describe("Headers", () => <
  test.it("lower-cases the name on add", () => <
    headers := Headers.empty()
    headers.add("X-Trace", "abc")
    expect(headers.has("x-trace"), equals(true))
  >)

  test.it("looks a value up case-insensitively", () => <
    headers := Headers.empty()
    headers.add("X-Trace", "abc")
    expect(headers.get("X-TRACE"), isOk())
  >)

  test.it("keeps the first value when a name is added twice", () => <
    headers := Headers.empty()
    headers.add("X-A", "1")
    headers.add("x-a", "2")
    firstValue :: Text = headers.get("x-a") ? | Ok(value) => value | NotOk(_) => "?"
    expect(firstValue, equals("1"))
  >)

  test.it("keeps every value added under one name", () => <
    headers := Headers.empty()
    headers.add("X-A", "1")
    headers.add("x-a", "2")
    expect(headers.all("x-a").size, equals(2))
  >)

  test.it("lists every name added, lower-cased", () => <
    headers := Headers.empty()
    headers.add("X-A", "1")
    headers.add("X-B", "2")
    expect(headers.names().size, equals(2))
  >)

  test.it("adds every entry of a map literal, lower-cased", () => <
    headers := Headers.empty()
    headers.add([|"X-A" => "1", "X-B" => "2"|])
    expect(headers.has("x-a"), equals(true))
    expect(headers.has("x-b"), equals(true))
  >)

  test.it("writes one name: value line per value", () => <
    headers := Headers.empty()
    headers.add("X-A", "1")
    headers.add("x-a", "2")
    expect(headers.wire(), contains("x-a: 1\r\n"))
    expect(headers.wire(), contains("x-a: 2\r\n"))
  >)

  test.it("parses two same-named header lines into one name with two values", () => <
    fromLines = Headers.parse(["X-A: 1", "X-A: 2"])
    expect(fromLines.all("x-a").size, equals(2))
  >)

  test.it("reports an absent name as NotOk", () =>
    expect(Headers.empty().get("x-absent"), isNotOk()))
>)

test.describe("Params", () => <
  test.it("keeps a repeated name's every value, and a single name's one", () => <
    parsedParams = Params.parse("q=ada&tag=a&tag=b")
    expect(parsedParams.all("tag").size, equals(2))
    firstQuery :: Text = parsedParams.get("q") ? | Ok(value) => value | NotOk(_) => "?"
    expect(firstQuery, equals("ada"))
  >)

  test.it("reads a bare name as an empty value", () => <
    flagOnly = Params.parse("flag")
    flagValue :: Text = flagOnly.get("flag") ? | Ok(value) => value | NotOk(_) => "?"
    expect(flagValue, equals(""))
  >)

  test.it("parses an empty query as no params at all", () =>
    expect(Params.parse("").names().size, equals(0)))

  test.it("compares names exactly, unlike Headers", () => <
    parsedParams = Params.parse("Q=ada")
    expect(parsedParams.has("Q"), equals(true))
    expect(parsedParams.has("q"), equals(false))
  >)
>)

test.describe("Request.params", () => <
  test.it("reads a repeated and a single query parameter off the URL", () => <
    request = Request.get("http://example.com/s?q=ada&tag=a&tag=b")
    expect(request.params().all("tag").size, equals(2))
  >)

  test.it("reads no params from a URL with no query", () =>
    expect(Request.get("http://example.com/s").params().names().size, equals(0)))
>)

test.describe("Request's static constructors", () => <
  test.it("get defaults to empty options", () => <
    request = Request.get("example.com/x")
    expect(request.method.token(), equals("GET"))
    expect(request.options.headers.names().size, equals(0))
  >)

  test.it("get accepts explicit options", () => <
    withOptions := RequestOptions.default()
    withOptions.headers.add("Accept", "text/plain")
    request := Request.get("example.com/x", withOptions)
    expect(request.options.headers.has("accept"), equals(true))
  >)

  test.it("post carries a body with default options", () => <
    request = Request.post("example.com/x", Body { content = "hi", contentType = "text/plain" })
    expect(request.method.token(), equals("POST"))
    expect(request.options.headers.names().size, equals(0))
  >)

  test.it("post accepts explicit options", () => <
    withOptions := RequestOptions.default()
    withOptions.headers.add("X-Trace", "abc")
    request := Request.post(
      "example.com/x", Body { content = "hi", contentType = "text/plain" }, withOptions)
    expect(request.options.headers.has("x-trace"), equals(true))
  >)

  test.it("options builds an OPTIONS request, distinct from the Options method variant", () => <
    request = Request.options("example.com/x")
    expect(request.method.token(), equals("OPTIONS"))
    expect(request.options.headers.names().size, equals(0))
  >)

  test.it("head, delete, put, patch and query each build their own method", () => <
    body = Body { content = "x", contentType = "text/plain" }
    expect(Request.head("example.com/x").method.token(), equals("HEAD"))
    expect(Request.delete("example.com/x").method.token(), equals("DELETE"))
    expect(Request.put("example.com/x", body).method.token(), equals("PUT"))
    expect(Request.patch("example.com/x", body).method.token(), equals("PATCH"))
    expect(Request.query("example.com/x", body).method.token(), equals("QUERY"))
  >)
>)

test.describe("reading a URL apart", () => <
  test.it("drops the scheme", () =>
    expect(Request.get("http://example.com/a").withoutScheme(), equals("example.com/a")))

  test.it("takes the authority from a URL with a path", () =>
    expect(Request.get("http://example.com/a/b").authority(), equals("example.com")))

  test.it("takes the authority from a URL with no path", () =>
    expect(Request.get("example.com").authority(), equals("example.com")))

  test.it("keeps a port in the authority", () =>
    expect(Request.get("http://example.com:8080/a").authority(), equals("example.com:8080")))

  test.it("defaults an absent path to /", () =>
    expect(Request.get("example.com").path(), equals("/")))

  test.it("keeps a path with a query string", () =>
    expect(Request.get("http://example.com/s?q=ada&n=1").path(), equals("/s?q=ada&n=1")))

  test.it("keeps a query string out of the authority", () => <
    ~ A URL with a query and no path: the `?` must not be read as part of the host, or the
    ~ Host header names a host that cannot resolve.
    bare = Request.get("http://example.com?a=b")
    expect(bare.authority(), equals("example.com"))
    expect(bare.path(), equals("/?a=b"))
  >)

  test.it("drops a fragment rather than putting it on the wire", () => <
    fragmented = Request.get("http://example.com/a#section")
    expect(fragmented.authority(), equals("example.com"))
    expect(fragmented.path(), equals("/a"))
  >)

  test.it("reads a bare host carrying only a fragment as the root path", () =>
    expect(Request.get("http://example.com#top").path(), equals("/")))

  test.it("drops userinfo from the authority", () =>
    expect(Request.get("http://ada@example.com/x").authority(), equals("example.com")))
>)

test.describe("serialising a request", () => <
  test.it("writes a GET exactly", () => <
    request = Request.get("http://example.com/index.html")
    expect(request.wire(), equals(
      "GET /index.html HTTP/1.1\r\nhost: example.com\r\nconnection: close\r\n\r\n"))
  >)

  test.it("writes a GET for a URL with no path exactly", () => <
    request = Request.get("example.com")
    expect(request.wire(), equals(
      "GET / HTTP/1.1\r\nhost: example.com\r\nconnection: close\r\n\r\n"))
  >)

  test.it("writes a POST with its body exactly", () => <
    request = Request.post("http://example.com/submit",
      Body { content = "name=ada", contentType = "application/x-www-form-urlencoded" })
    expect(request.wire(), equals(
      "POST /submit HTTP/1.1\r\nhost: example.com\r\nconnection: close\r\n"
        + "content-type: application/x-www-form-urlencoded\r\ncontent-length: 8\r\n"
        + "\r\nname=ada"))
  >)

  test.it("writes a QUERY with its body exactly", () => <
    request = Request.query("http://example.com/search",
      Body { content = "{\"q\":\"ada\"}", contentType = "application/json" })
    expect(request.wire(), equals(
      "QUERY /search HTTP/1.1\r\nhost: example.com\r\nconnection: close\r\n"
        + "content-type: application/json\r\ncontent-length: 11\r\n"
        + "\r\n{\"q\":\"ada\"}"))
  >)

  test.it("counts Content-Length in bytes, not characters", () => <
    ~ "héllo" is five characters and six UTF-8 bytes; the wire wants bytes.
    request = Request.put("example.com/x", Body { content = "héllo", contentType = "text/plain" })
    expect(request.wire(), contains("content-length: 6\r\n"))
  >)

  test.it("sends no body headers for a method carrying no body", () => <
    request = Request.delete("example.com/gone")
    expect(request.wire(), not(contains("content-type")))
    expect(request.wire(), not(contains("content-length")))
  >)

  test.it("sends Content-Length: 0 for a body-bearing method with empty content", () => <
    ~ Empty content is a body of length zero, not the absence of a body; a POST with no
    ~ Content-Length at all draws a 411 from real servers.
    request = Request.post("example.com/x", Body { content = "", contentType = "text/plain" })
    expect(request.wire(), equals(
      "POST /x HTTP/1.1\r\nhost: example.com\r\nconnection: close\r\n"
        + "content-type: text/plain\r\ncontent-length: 0\r\n"
        + "\r\n"))
  >)

  test.it("names the port in Host when the URL carries one", () =>
    expect(Request.head("http://example.com:8080/p").wire(), contains("host: example.com:8080\r\n")))

  test.it("writes a HEAD request line", () =>
    expect(Request.head("example.com/p").wire(), contains("HEAD /p HTTP/1.1\r\n")))

  test.it("writes a DELETE request line", () =>
    expect(Request.delete("example.com/p").wire(), contains("DELETE /p HTTP/1.1\r\n")))

  test.it("writes a PUT request line with its body", () => <
    request = Request.put("example.com/p", Body { content = "replaced", contentType = "text/plain" })
    expect(request.wire(), equals(
      "PUT /p HTTP/1.1\r\nhost: example.com\r\nconnection: close\r\n"
        + "content-type: text/plain\r\ncontent-length: 8\r\n"
        + "\r\nreplaced"))
  >)

  test.it("a caller header replaces the generated content-type", () => <
    withOptions := RequestOptions.default()
    withOptions.headers.add("Content-Type", "application/json")
    request := Request.post(
      "example.com/x", Body { content = "{}", contentType = "text/plain" }, withOptions)
    expect(request.wire(), contains("content-type: application/json\r\n"))
    expect(request.wire(), not(contains("text/plain")))
  >)

  test.it("a caller header goes on the wire lower-cased", () => <
    withOptions := RequestOptions.default()
    withOptions.headers.add("X-Trace", "abc123")
    request := Request.get("example.com/x", withOptions)
    expect(request.wire(), contains("x-trace: abc123\r\n"))
  >)
>)

test.describe("a round trip", () => <
  test.it("parses a reply built from a request's own body", () => <
    ~ Serialise a POST, then hand its body back as a reply's body: what goes out and what
    ~ comes in agree on where the blank line falls.
    sent = "name=ada"
    request = Request.post("example.com/echo", Body { content = sent, contentType = "text/plain" })
    expect(request.wire(), contains("\r\n\r\n" + sent))
    echoed = parsed("HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\n\r\n" + sent)
    expect(echoed.body(), equals(sent))
    expect(echoed.status(), equals(200))
  >)
>)
