~ core.http — a minimal HTTP client built entirely on core.net's @tcpRequest.
~ Import with `<< core.http`. Reference: docs/corelib/http.md.
~
~ HTTP only (no TLS). Each request opens one connection, sends `Connection: close`, and
~ reads the close-delimited reply. `Request` and `Response` are rich-but-lazy: they hold
~ the raw text and parse a field only when a method asks for it.
~
~ Requests go out as HTTP/1.0, which forbids the chunked transfer-encoding this module
~ has no decoder for; the connection close alone delimits the body. Replies are read
~ leniently: HTTP/1.0 or 1.1, CRLF or bare LF.

<< core.net

~ A request body: the text to send and the media type to advertise for it.
>> Body = { content :: Text, contentType :: Text }

~ The HTTP method. Body-bearing methods carry a `Body`; the rest are nullary.
>> Method = Get / Post(Body) / Put(Body) / Query(Body) / Delete / Head {
  ~ The token this method writes in a request line.
  token = () -> Text => it ?
    | Get      => "GET"
    | Post(_)  => "POST"
    | Put(_)   => "PUT"
    | Query(_) => "QUERY"
    | Delete   => "DELETE"
    | Head     => "HEAD"

  ~ The body this method carries — an empty one for the methods that carry none.
  payload = () -> Body => it ?
    | Post(carried)  => carried
    | Put(carried)   => carried
    | Query(carried) => carried
    | _              => Body { content = "", contentType = "" }
}

~ A reply: the raw response text, read through the methods below.
>> Response = {
  raw :: Text,

  ~ The blank line separating the headers from the body, as it appears in this reply:
  ~ CRLF, bare LF, or "" for a reply that has none. The EARLIER of the two wins, which
  ~ matters for a bare-LF reply whose body carries a CRLF blank line of its own: taking
  ~ CRLF on sight would put the head/body split inside the body.
  separator = () -> Text => <
    lineFeedSplitsFirst = it.raw.indexOf("\n\n") ?
      | Ok(lineFeedAt) => (it.raw.indexOf("\r\n\r\n") ?
        | Ok(crlfAt) => lineFeedAt < crlfAt
        | NotOk(_)   => true)
      | NotOk(_) => false
    lineFeedSplitsFirst ? "\n\n" : (it.raw.contains("\r\n\r\n") ? "\r\n\r\n" : "")
  >

  ~ Everything before the blank line — the status line and the header lines — with CRLF
  ~ endings normalised to LF, so one code path reads a CRLF reply and a bare-LF one. The
  ~ normalisation also keeps indices honest: `\r\n` is ONE grapheme cluster, so searching
  ~ a CRLF text for `\n` and slicing at what it finds would land a character late. A reply
  ~ with no blank line at all is all head and no body.
  head = () -> Text => <
    blankLine = it.separator()
    section = blankLine == "" ? it.raw : (it.raw.indexOf(blankLine) ?
      | Ok(mark) => it.raw.slice(0, mark)
      | NotOk(_) => it.raw)
    section.replaceAll("\r\n", "\n")
  >

  ~ The reply's first line, trimmed: `HTTP/1.1 200 OK`.
  statusLine = () -> Text => <
    section = it.head()
    section.indexOf("\n") ?
      | Ok(mark) => section.slice(0, mark).trim()
      | NotOk(_) => section.trim()
  >

  ~ The header lines, trimmed and without the status line. A line carrying no colon is
  ~ not a header and is left out, so a garbled reply yields the headers it does have.
  headers = () -> []Text => <
    section = it.head()
    afterStatusLine = section.indexOf("\n") ?
      | Ok(mark) => section.slice(mark + 1, section.length)
      | NotOk(_) => ""
    afterStatusLine.split("\n").map(line => line.trim()).filter(line => line.contains(":"))
  >

  ~ The numeric status code (`HTTP/1.0 200 OK` -> 200), or 0 when the status line carries
  ~ no code that is digits throughout — a garbled reply reads as 0 rather than guessing.
  status = () -> Num => <
    digitOf = (grapheme :: Text) -> Result => "0123456789".indexOf(grapheme)
    isDigit = (grapheme :: Text) -> Bool => digitOf(grapheme) ?
      | Ok(_)    => true
      | NotOk(_) => false
    fields = it.statusLine().split(" ")
    code = fields.size > 1 ? fields[1] : ""
    graphemes = code.split("")
    allDigits = code.length > 0
      && graphemes.filter(grapheme => isDigit(grapheme)).size == graphemes.size
    allDigits
      ? graphemes.reduce(0, (accumulator, grapheme) => digitOf(grapheme) ?
        | Ok(digit) => accumulator * 10 + digit
        | NotOk(_)  => accumulator)
      : 0
  >

  ~ Look up a header by name, case-insensitively: `Ok(value)` or `NotOk(name)`. The value
  ~ is trimmed, so `X-Empty:` yields `Ok("")`; when a name repeats, the first line wins.
  header = (name :: Text) -> Result => <
    wanted = name.trim().toLower()
    nameOf = (line :: Text) -> Text => line.indexOf(":") ?
      | Ok(colon) => line.slice(0, colon).trim().toLower()
      | NotOk(_)  => ""
    valueOf = (line :: Text) -> Text => line.indexOf(":") ?
      | Ok(colon) => line.slice(colon + 1, line.length).trim()
      | NotOk(_)  => ""
    it.headers().find(line => nameOf(line) == wanted) ?
      | Ok(line) => Ok(valueOf(line))
      | NotOk(_) => NotOk(name)
  >

  ~ The body: everything after the blank line, character for character, and "" for a reply
  ~ with no blank line. `Content-Length` is not consulted — the close delimits the body —
  ~ so a body carrying its own CRLF survives intact.
  body = () -> Text => <
    blankLine = it.separator()
    blankLine == "" ? "" : (it.raw.indexOf(blankLine) ?
      | Ok(mark) => it.raw.slice(mark + blankLine.length, it.raw.length)
      | NotOk(_) => "")
  >
}

~ Wrap raw response text as a `Response`, rejecting a reply with no HTTP status line:
~ `Ok(Response)` / `NotOk(errorText)`.
>> parseResponse = (raw :: Text) -> Result =>
  raw.slice(0, 4) == "HTTP" && raw.contains("\n")
    ? Ok(Response { raw = raw })
    : NotOk("malformed HTTP response")

~ A request: the method and the target URL (`http://host[:port]/path`, scheme optional).
>> Request = {
  method :: Method,
  url :: Text,

  ~ The URL with any `scheme://` prefix removed: `host[:port]/path`.
  withoutScheme = () -> Text => it.url.indexOf("://") ?
    | Ok(mark) => it.url.slice(mark + 3, it.url.length)
    | NotOk(_) => it.url

  ~ The `host[:port]` to connect to, and what the `Host` header carries.
  authority = () -> Text => <
    rest = it.withoutScheme()
    rest.indexOf("/") ?
      | Ok(mark) => rest.slice(0, mark)
      | NotOk(_) => rest
  >

  ~ The path the request line asks for; `/` when the URL carries none.
  path = () -> Text => <
    rest = it.withoutScheme()
    rest.indexOf("/") ?
      | Ok(mark) => rest.slice(mark, rest.length)
      | NotOk(_) => "/"
  >

  ~ The request serialised to the text that goes on the wire. A body-bearing method adds
  ~ `Content-Type` and a `Content-Length` counted in BYTES, then the body after the blank
  ~ line.
  wire = () -> Text => <
    carried = it.method.payload()
    requestLine = "`it.method.token()` `it.path()` HTTP/1.0\r\n"
    headers = "Host: `it.authority()`\r\nConnection: close\r\n"
    bodyHeaders = carried.content.size > 0
      ? "Content-Type: `carried.contentType`\r\nContent-Length: `carried.content.size`\r\n"
      : ""
    requestLine + headers + bodyHeaders + "\r\n" + carried.content
  >

  ~ Perform the request over core.net and read the reply into `Ok(Response)`; a transport
  ~ failure arrives as the `NotOk(errorText)` the primitive reported, never as a crash.
  send = () -> Result => <
    host = it.authority()
    address = host.contains(":") ? host : host + ":80"
    @tcpRequest(address, it.wire()) ?
      | Ok(responseText) => parseResponse(responseText)
      | NotOk(problem)   => NotOk(problem)
  >
}

~ Fetch a URL with a GET request: `Ok(Response)` / `NotOk(errorText)`.
>> get = (url :: Text) -> Result => <
  request = Request { method = Get, url = url }
  request.send()
>
